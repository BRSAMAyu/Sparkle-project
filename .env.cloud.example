# =============================================================================
# Sparkle Cloud Bootstrap Overlay — 云端安全默认值模板（D-BOOTSTRAP）
# =============================================================================
# 定位：这是「云上 .env 装配」的**追加层（overlay）**，不是完整模板。
#   完整基线 = `.env.production.example`（601 行，全部变量与三级标注）。
#   装配方式（由 scripts/deploy/bootstrap.sh 自动完成，等价手工命令）：
#     cat .env.production.example .env.cloud.example > .env && chmod 600 .env
#   同名变量**后者生效**（docker compose env file 重复键 last-wins，已实测），
#   因此本文件里的显式钉死值会覆盖基线模板中语义相反的默认值。
#
# 标记约定（bootstrap 的占位符门禁会识别以下形态并拒绝继续）：
#   __CHANGE_ME__      必须人工替换（下面所有占位统一用它，便于机器扫描）
#   <...>              基线模板遗留的占位形态，同样会被拒绝
#   your_/replace_with/changeme/placeholder/example_/dummy_ 前缀同样被拒绝
#
# 本文件**绝不放真实密钥**；所有人工填空项都注明密钥来源（去哪里申请/生成）。
# =============================================================================

# === sparkle cloud defaults (bootstrap overlay marker; do not remove) ===

# ---------------------------------------------------------------------------
# 1. 运行姿态钉死（幂等重申，防手工 .env 漏配）
# ---------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False

# ---------------------------------------------------------------------------
# 2. 成本安全默认值（D 线 R1 结论 §4：三个「演示友好、生产危险」开关全部反转为生产姿态）
# ---------------------------------------------------------------------------
# 用户日 token 配额层（LLMCostGuard）——基线 settings 默认 False（为演示录制），
# 云上必须显式开启，否则用户级配额形同虚设（还有分类目日预算/背压/run 预算三层兜底）。
LLM_QUOTA_ENABLED=true

# glm_batch 停车道：云上默认熄火（基线 .env.production.example 里是 true）。
# bootstrap 另会在 up 时 --scale celery_glm_batch_worker=0 双保险；
# 确需离线批处理时：先清空 glm_batch 队列，再改 true 并手动拉起 worker，用完即停。
GLM_BATCH_ENABLED=false

# Run 面预算派生（settings 默认已 true，这里显式钉死）
RUN_BUDGET_DEFAULTS_ENABLED=true

# 日预算收紧档（美元）：参展/首批用户量级起步值，烧穿即熔断（四桶预算 + Redis 有界降级）
LLM_DAILY_BUDGET_USD=5
RAG_DAILY_BUDGET_USD=1
AURORA_DAILY_BUDGET_USD=2
BATCH_LANE_DAILY_BUDGET_USD=0.5

# O-07 背压硬顶保持现值（glm_batch=200 自动丢弃）
QUEUE_BACKPRESSURE_LIMITS_JSON={"glm_batch": 200}

# ---------------------------------------------------------------------------
# 3. 人工填空项（占位未替换 = bootstrap 拒绝继续，并列出缺哪些）
# ---------------------------------------------------------------------------

# --- LLM Provider [必须至少填一个 key] ---
# 主 provider 固定 qwen（双核路由主力档）；key 来源：
#   阿里云百炼控制台 https://bailian.console.aliyun.com/ 开通 DashScope 后创建 API Key
LLM_PROVIDER=qwen
LLM_API_KEY=__CHANGE_ME__
# 备 provider 建议至少再填一个（故障切换面已支持）；来源示例：
#   DeepSeek  https://platform.deepseek.com/  → DEEPSEEK_API_KEY
#   智谱      https://open.bigmodel.cn/       → ZHIPU_API_KEY
#   硅基流动  https://siliconflow.cn/         → SILICONFLOW_API_KEY
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=

# --- 领域名派生项 [把 example.com 换成你的域名] ---
# 网关信任的反代网段：单机 compose 部署 = nginx 容器所在 docker 网段。
# 常见默认 docker 网段 172.16.0.0/12；更紧可用 `docker network inspect sparkle_edge` 实测后收紧。
TRUSTED_PROXIES=__CHANGE_ME__
# 网关 CORS 白名单：只放行你自己的前端来源（HTTPS）。评审演示期可先只留 API 域名。
ALLOWED_ORIGINS=https://api.example.com
# 后端 CORS（JSON 数组格式）——收紧注释：生产只允许真实前端来源；
# 若移动端直连 API 无浏览器同源问题，可保留最小集合，勿用 ["*"]。
BACKEND_CORS_ORIGINS=["https://api.example.com"]
# 生产对外 URL（HTTPS，deeplink/邮件链接用）
PRODUCTION_URL=https://api.example.com

# --- Alertmanager webhook [compose :? 硬门，缺了起不来] ---
# 最简可用：企业微信/钉钉/飞书群机器人 webhook 地址（三家任一，参展期够用）
ALERTMANAGER_DEFAULT_WEBHOOK_URL=__CHANGE_ME__
ALERTMANAGER_CRITICAL_WEBHOOK_URL=__CHANGE_ME__
ALERTMANAGER_WARNING_WEBHOOK_URL=__CHANGE_ME__

# --- JWT RS256 密钥对 [RECOMMENDED，基线默认 RS256] ---
# 生成：
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# 粘贴时按 .env 多行值的约定处理（或先用 base64 再由应用侧解码的项目约定为准）。
JWT_PRIVATE_KEY=__CHANGE_ME__
JWT_PUBLIC_KEY=__CHANGE_ME__

# --- 演示账号密码 [仅 --with-demo-seed 时必填] ---
# bootstrap 的 seed 步骤会读取；留占位时 bootstrap 自动生成一次并写回 .env。
# 演示账号本身不上二维码（防改密/灌脏数据），观众走 /guest 游客链路。
LOCAL_SMOKE_PASSWORD=

# ---------------------------------------------------------------------------
# 4. 镜像引用（与 .github/workflows/ci.yml 的 ghcr 产物对应）
# ---------------------------------------------------------------------------
IMAGE_TAG=__CHANGE_ME__
GATEWAY_IMAGE=ghcr.io/__CHANGE_ME__/sparkle-gateway
BACKEND_IMAGE=ghcr.io/__CHANGE_ME__/sparkle-backend
