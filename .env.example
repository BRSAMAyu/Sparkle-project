# Database Configuration (canonical)
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@sparkle_db:5432/sparkle

# Redis Configuration
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@sparkle_redis:6379/0

# Security
JWT_SECRET=change-me-in-production

# LLM Configuration
LLM_API_BASE_URL=
LLM_API_KEY=

# Note: Never commit actual secrets to version control
# Use this file as the canonical local dev source; cloud uses env vars only.
