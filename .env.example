# Database Configuration (canonical)
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@sparkle_db:5432/sparkle

# Redis Configuration
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@sparkle_redis:6379/0

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sparkle-files

# Container URLs (可选覆盖)
# DATABASE_URL=postgresql://postgres:devpassword@sparkle_db:5432/sparkle
# REDIS_URL=redis://:devpassword@sparkle_redis:6379/0
# CELERY_BROKER_URL=redis://:devpassword@sparkle_redis:6379/1
# CELERY_RESULT_BACKEND=redis://:devpassword@sparkle_redis:6379/2

# Note: Never commit actual secrets to version control
# Use this file as the canonical local dev source; cloud uses env vars only.

# Social Login
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_CLIENT_ID=your-apple-client-id
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret