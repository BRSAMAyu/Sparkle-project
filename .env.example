# Root environment variables for docker-compose services.
# Copy to .env and fill with real values (do not commit secrets).

ENVIRONMENT=development
DEBUG=True

POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Production compose DB aliases
DB_HOST=sparkle_db
DB_PORT=5432
DB_NAME=sparkle
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@sparkle_db:5432/sparkle

REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@sparkle_redis:6379/0

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=sparkle-files
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true

JWT_SECRET=your_jwt_secret
INTERNAL_API_KEY=your_internal_api_key
ADMIN_SECRET=your_admin_secret

# OpenClaw delegated execution
# docker-compose injects host.docker.internal routes for containers automatically.
OPENCLAW_ENABLED=true
OPENCLAW_TRANSPORT=gateway_ws
OPENCLAW_DEFAULT_AGENT_ID=main
OPENCLAW_DEFAULT_TIMEOUT_SECONDS=300
OPENCLAW_MAX_CONCURRENT_RUNS=3

BACKEND_URL=http://sparkle_api:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
CELERY_BROKER_URL=redis://:your_redis_password@sparkle_redis:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@sparkle_redis:6379/2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
ALERTMANAGER_DEFAULT_WEBHOOK_URL=http://host.docker.internal:19093/alerts/default
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://host.docker.internal:19093/alerts/critical
ALERTMANAGER_WARNING_WEBHOOK_URL=http://host.docker.internal:19093/alerts/warning
ALERTMANAGER_EMAIL_TO=ops@example.com
ALERTMANAGER_EMAIL_FROM=sparkle-alerts@example.com
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=

# Release/deploy variables
IMAGE_TAG=latest
GATEWAY_IMAGE=ghcr.io/your-org/sparkle-gateway
BACKEND_IMAGE=ghcr.io/your-org/sparkle-backend

# File service policy
FILE_MAX_UPLOAD_SIZE=52428800
FILE_PRESIGN_EXPIRES_SECONDS=420
FILE_GC_INTERVAL_MINUTES=60
FILE_GC_GRACE_HOURS=24
FILE_GC_BATCH_SIZE=200

# Optional chaos toggles
CHAOS_ENABLED=false
CHAOS_ALLOW_PROD=false

# gRPC TLS (required when ENVIRONMENT=production for agent service role)
GRPC_TLS_CERT_PATH=/run/secrets/grpc_server.crt
GRPC_TLS_KEY_PATH=/run/secrets/grpc_server.key

# AI Four-Phase Launch
ENABLE_CONTEXT_FOCUSING=true
ENABLE_CONTEXT_SEMANTIC_GATING=true
ENABLE_CONTEXT_BRIEFING=true
ENABLE_CONTEXT_FOCUS_METADATA=true
ENABLE_SESSION_FEEDBACK_ADAPTATION=true
ENABLE_ADAPTIVE_PRESENTATION=true
ENABLE_STRUCTURED_NEXT_ACTIONS=true
ENABLE_BLOCKED_TEMPERATURE=true
ENABLE_UX_PRESENTATION_METADATA=true
ENABLE_PERCEPTIBLE_INTELLIGENCE=true
ENABLE_PROACTIVE_INSIGHTS=true
ENABLE_PLAN_REASONING_SUMMARY=true
ENABLE_WEEKLY_LEARNING_REPORT=true
ENABLE_PROGRESS_COMPARISONS=true

# Aurora tri-state kill switches (off | shadow | live)
SPARKLE_MEMORY_INFERRED_WRITE_ENABLED=true
AURORA_STAGE18_AGGREGATOR_MODE=live
AURORA_STAGE18_PUSH_POLICY_MODE=off
AURORA_STAGE18_PUSH_DELIVERY_MODE=off
AURORA_STAGE19_WORKING_MEMORY_MODE=off
AURORA_STAGE19_LLM_EXTRACTOR_MODE=off
AURORA_STAGE19_CONSOLIDATION_MODE=off
AURORA_STAGE21_SKILL_STORE_MODE=live
AURORA_STAGE21_SKILL_SELECTION_MODE=off
AURORA_STAGE21_SKILL_SHARE_MODE=off
AURORA_BAYESIAN_MODE=shadow
AURORA_POLICY_COMPILER_MODE=off
AURORA_REFLECTION_WIRE_MODE=off
AURORA_SCENE_MODE=off
AURORA_FORESIGHT_MODE=off
AURORA_TRAITS_MODE=off
AURORA_TRAITS_NLP_MODE=off
AURORA_TRAITS_COLDSTART_MODE=off
AURORA_SRL_MODE=off
AURORA_SRL_TRACKER_MODE=off
AURORA_SRL_BRIDGE_MODE=off
AURORA_SRL_SCAFFOLDING_CONSUME_MODE=off
AURORA_METACOG_MODE=off
AURORA_METACOG_DASHBOARD_MODE=live
AURORA_METACOG_PROCESS_SCAFFOLDING_MODE=live
AURORA_METACOG_FSM_COMBINE_MODE=live
AURORA_IDIOGRAPHIC_MODE=shadow
AURORA_STAGE33_MODE=shadow
AURORA_STAGE33_SOCIAL_MODE=live
AURORA_STAGE33_SRL_MODE=shadow
AURORA_STAGE33_WM_PROMPT_MODE=shadow
AURORA_STAGE33_EVENTS_MODE=shadow
