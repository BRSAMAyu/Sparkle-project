# Root environment variables for docker-compose services.
# Copy to .env and fill with real values (do not commit secrets).

ENVIRONMENT=development
DEBUG=True

POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

JWT_SECRET=your_jwt_secret
INTERNAL_API_KEY=your_internal_api_key

# Proto compatibility flags
PROTO_READ_NEW_FIRST=true
PROTO_WRITE_DUAL=true
