# Root environment variables for docker-compose services.
# Copy to .env and fill with real values (do not commit secrets).

ENVIRONMENT=development
DEBUG=True

POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Production compose DB aliases
DB_HOST=sparkle_db
DB_PORT=5432
DB_NAME=sparkle
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@sparkle_db:5432/sparkle

REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@sparkle_redis:6379/0

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=sparkle-files
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true

JWT_SECRET=your_jwt_secret
INTERNAL_API_KEY=your_internal_api_key
ADMIN_SECRET=your_admin_secret

BACKEND_URL=http://sparkle_api:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
CELERY_BROKER_URL=redis://:your_redis_password@sparkle_redis:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@sparkle_redis:6379/2

# Release/deploy variables
IMAGE_TAG=latest
GATEWAY_IMAGE=ghcr.io/your-org/sparkle-gateway
BACKEND_IMAGE=ghcr.io/your-org/sparkle-backend

# File service policy
FILE_MAX_UPLOAD_SIZE=52428800
FILE_PRESIGN_EXPIRES_SECONDS=420
FILE_GC_INTERVAL_MINUTES=60
FILE_GC_GRACE_HOURS=24
FILE_GC_BATCH_SIZE=200

# Optional chaos toggles
CHAOS_ENABLED=false
CHAOS_ALLOW_PROD=false

# gRPC TLS (required when ENVIRONMENT=production for agent service role)
GRPC_TLS_CERT_PATH=/run/secrets/grpc_server.crt
GRPC_TLS_KEY_PATH=/run/secrets/grpc_server.key
