# =============================================================================
# Sparkle Production Environment Template
# =============================================================================
# Copy this file to .env on your production server and fill in ALL values.
#
# Markers:
#   [MUST CHANGE]  Secrets that require unique, strong values. Startup will
#                  fail if these contain placeholder prefixes like "your_" or
#                  "replace_with".
#   [RECOMMENDED]  Has safe defaults but should be reviewed for your deployment.
#   [OPTIONAL]     Can be left as-is unless customization is needed.
#
# SECURITY: Never commit this file with real values.
# Use a secrets manager (GitHub Secrets, Vault, AWS SSM) for sensitive values.
#
# Validation: python scripts/check_production_secrets.py
# =============================================================================

# ---------------------------------------------------------------------------
# Core Application
# ---------------------------------------------------------------------------
ENVIRONMENT=production
# [MUST CHANGE] Must be False in production (enforced by settings validator)
DEBUG=False
APP_NAME=Sparkle
SERVICE_ROLE=api  # api | grpc | worker | beat | celery-glm-batch

# ---------------------------------------------------------------------------
# Security Secrets  [MUST CHANGE - ALL OF THESE]
# ---------------------------------------------------------------------------
# [MUST CHANGE] Minimum 32 characters.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<generate-32-plus-char-secret-key>
# [MUST CHANGE] JWT signing secret (minimum 32 characters)
JWT_SECRET=<generate-32-plus-char-jwt-secret>
# [MUST CHANGE] Admin secret for protected management endpoints
ADMIN_SECRET=<generate-strong-admin-secret>
# [MUST CHANGE] Internal API key for service-to-service authentication
INTERNAL_API_KEY=<generate-strong-internal-api-key>

# ---------------------------------------------------------------------------
# JWT Configuration  [RECOMMENDED]
# ---------------------------------------------------------------------------
# Production should use RS256 for asymmetric signing. Generate RSA key pair:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
ALGORITHM=RS256
JWT_PRIVATE_KEY=<paste-PEM-encoded-RSA-private-key>
JWT_PUBLIC_KEY=<paste-PEM-encoded-RSA-public-key>
JWT_ISSUER=sparkle-gateway
JWT_AUDIENCE=sparkle-app
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# [RECOMMENDED] Key version for rotation grace periods
SPARKLE_JWT_KEY_VERSION=v1
SPARKLE_JWT_PREVIOUS_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL Database  [MUST CHANGE]
# ---------------------------------------------------------------------------
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=sparkle_app
# [MUST CHANGE] Strong, unique password
POSTGRES_PASSWORD=<generate-strong-postgres-password>
DATABASE_URL=postgresql+asyncpg://sparkle_app:<POSTGRES_PASSWORD>@sparkle_db:5432/sparkle
# Aliases used by docker-compose.prod.yml
DB_HOST=sparkle_db
DB_PORT=5432
DB_NAME=sparkle
DB_USER=sparkle_app
DB_PASSWORD=<same-as-POSTGRES_PASSWORD>

# [MUST CHANGE] Per-service database URLs (required when SPARKLE_RBAC_ENABLED=true)
SPARKLE_RBAC_ENABLED=true
SPARKLE_GATEWAY_DATABASE_URL=postgresql://sparkle_gateway:<generate-password>@sparkle_db:5432/sparkle
SPARKLE_ENGINE_DATABASE_URL=postgresql+asyncpg://sparkle_engine:<generate-password>@sparkle_db:5432/sparkle
SPARKLE_CELERY_DATABASE_URL=postgresql+asyncpg://sparkle_celery:<generate-password>@sparkle_db:5432/sparkle

# PostgreSQL tuning [RECOMMENDED - adjust based on server RAM]
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_WAL_SIZE=2GB

# Database pool settings [RECOMMENDED]
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=False

# ---------------------------------------------------------------------------
# Redis  [MUST CHANGE]
# ---------------------------------------------------------------------------
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
# [MUST CHANGE] Strong, unique password
REDIS_PASSWORD=<generate-strong-redis-password>
REDIS_URL=redis://:<REDIS_PASSWORD>@sparkle_redis:6379/0
REDIS_FAIL_CLOSED=true

# [RECOMMENDED] Per-service Redis credentials for RBAC isolation
SPARKLE_GATEWAY_REDIS_PASSWORD=<generate-or-use-REDIS_PASSWORD>
SPARKLE_ENGINE_REDIS_PASSWORD=<generate-or-use-REDIS_PASSWORD>
SPARKLE_CELERY_REDIS_PASSWORD=<generate-or-use-REDIS_PASSWORD>

# Celery Redis URLs
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@sparkle_redis:6379/1
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@sparkle_redis:6379/2

# ---------------------------------------------------------------------------
# MinIO Object Storage  [MUST CHANGE]
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=<generate-minio-root-user>
# [MUST CHANGE] Strong, unique password (not "minioadmin")
MINIO_ROOT_PASSWORD=<generate-minio-root-password>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<generate-minio-access-key>
# [MUST CHANGE] Must not be "minioadmin" in production
MINIO_SECRET_KEY=<generate-minio-secret-key>
MINIO_BUCKET=sparkle-files
# [RECOMMENDED] Set to true in production; requires MinIO behind a TLS proxy
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true
# [RECOMMENDED] Public-facing endpoint for presigned URLs
MINIO_PUBLIC_ENDPOINT=

# Per-bucket credentials [RECOMMENDED]
MINIO_UPLOADS_BUCKET=sparkle-uploads
MINIO_UPLOADS_ACCESS_KEY=sparkle_uploads
MINIO_UPLOADS_SECRET_KEY=<generate-uploads-secret>
MINIO_EXPORTS_BUCKET=sparkle-exports
MINIO_EXPORTS_ACCESS_KEY=sparkle_exports
MINIO_EXPORTS_SECRET_KEY=<generate-exports-secret>
MINIO_BACKUPS_BUCKET=sparkle-backups
MINIO_BACKUPS_ACCESS_KEY=sparkle_backups
MINIO_BACKUPS_SECRET_KEY=<generate-backups-secret>

# File service policy [RECOMMENDED]
FILE_MAX_UPLOAD_SIZE=52428800
FILE_PRESIGN_EXPIRES_SECONDS=420
FILE_GC_INTERVAL_MINUTES=60
FILE_GC_GRACE_HOURS=24
FILE_GC_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# LLM Provider Configuration  [MUST CHANGE - at least one provider required]
# ---------------------------------------------------------------------------
LLM_PROVIDER=qwen
# [MUST CHANGE] At least one LLM API key is required in production
LLM_API_KEY=<your-llm-api-key>
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
LLM_REASON_MODEL_NAME=deepseek-reasoner

# LLM Tier Routing [OPTIONAL] - comma-separated model keys from LLMRouter
LLM_TIER_FREE=
LLM_TIER_FREE_FAST=
LLM_TIER_FREE_REASONING=
LLM_TIER_FAST=
LLM_TIER_STANDARD=
LLM_TIER_PLUS=
LLM_TIER_PRO=
LLM_TIER_REASONING=
LLM_TIER_MAX=
LLM_TIER_GLM_BATCH=
LLM_TIER_SPECIALIST=

# XiaoMi MIMO [OPTIONAL]
XIAOMI_MIMO_API_KEY=
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_CHAT_MODEL=mimo-v2-flash
XIAOMI_STANDARD_MODEL=mimo-v2-flash
XIAOMI_PRO_MODEL=MiMo-V2.5
XIAOMI_TEMPERATURE=0.3
XIAOMI_PRO_TEMPERATURE=0.3
XIAOMI_MIMO_TOKEN_PLAN_API_KEY=
XIAOMI_MIMO_TOKEN_PLAN_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek [OPTIONAL]
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASON_MODEL=deepseek-v4-pro

# Zhipu GLM [OPTIONAL]
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_CHAT_MODEL=glm-4.7
ZHIPU_TOOLS_MODEL=glm-4.7
ZHIPU_FLASH_MODEL=glm-4.7-flashx
GLM_4_7_FLASH_MODEL=glm-4.7-flash
ZHIPU_AIR_MODEL=glm-4.5-air
ZHIPU_LIGHT_MODEL=glm-4.6
ZHIPU_MAX_MODEL=glm-5
ZHIPU_TEMPERATURE=0.3
ZHIPU_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_OCR_MODEL=glm-ocr
ZHIPU_OCR_TIMEOUT_SECONDS=120

# DashScope (Aliyun) [OPTIONAL]
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL_COMPATIBLE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.6-plus
DASHSCOPE_REASON_MODEL=qwen3.6-plus
DASHSCOPE_FAST_MODEL=qwen3.6-flash
DASHSCOPE_STANDARD_MODEL=qwen3.5-flash
DASHSCOPE_TEMPERATURE=0.7
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# SiliconFlow [OPTIONAL]
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_FREE_MODEL=Qwen/Qwen3.5-4B
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SILICONFLOW_OCR_TIMEOUT_SECONDS=120
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# Translation (Hunyuan via SiliconFlow) [OPTIONAL]
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.siliconflow.cn/v1
HUNYUAN_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B
SILICONFLOW_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B
TRANSLATION_PRIMARY_PROVIDER=hunyuan
TRANSLATION_BACKUP_PROVIDER=siliconflow
TRANSLATION_PROVIDER_TIMEOUT_SECONDS=30

# Embedding & Reranking [RECOMMENDED]
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BACKUP_PROVIDER=siliconflow
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_PROVIDER=dashscope
RERANK_BACKUP_PROVIDER=siliconflow
RERANK_MODEL=qwen3-rerank

# OCR [RECOMMENDED]
OCR_PROVIDER=zhipu
OCR_BACKUP_PROVIDER=siliconflow

# ---------------------------------------------------------------------------
# STT (Speech-to-Text) [OPTIONAL]
# ---------------------------------------------------------------------------
STT_PROVIDER=zhipu
STT_BACKUP_PROVIDER=xunfei
STT_ENHANCE_ENABLED=true

# XunFei STT
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_STT_DOMAIN=slm
XUNFEI_STT_LANGUAGE=zh-CN
XUNFEI_STT_SAMPLE_RATE=16000
XUNFEI_STT_MAX_AUDIO_DURATION=60
XUNFEI_STT_EOS_MS=6000

# Zhipu ASR
ZHIPU_ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_ASR_MODEL=glm-asr-2512
ZHIPU_ASR_SAMPLE_RATE=16000
ZHIPU_ASR_STREAM_SEGMENT_SECONDS=4
ZHIPU_ASR_MAX_AUDIO_SECONDS=30
ZHIPU_ASR_MAX_FILE_SIZE_BYTES=26214400
ZHIPU_ASR_REQUEST_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# GLM Batch [OPTIONAL]
# ---------------------------------------------------------------------------
GLM_BATCH_ENABLED=true
GLM_BATCH_QUEUE=glm_batch
GLM_BATCH_MIN_CONCURRENCY=1
GLM_BATCH_MAX_CONCURRENCY=6
GLM_BATCH_PEAK_START_HOUR=14
GLM_BATCH_PEAK_END_HOUR=18
GLM_BATCH_PEAK_CONCURRENCY=2
GLM_BATCH_OFFPEAK_DEFAULT_CONCURRENCY=3
GLM_BATCH_ADAPTIVE_ENABLED=true
GLM_BATCH_ADAPTIVE_SUCCESS_THRESHOLD=8
GLM_BATCH_ADAPTIVE_INCREASE_COOLDOWN_SECONDS=180
GLM_BATCH_ADAPTIVE_RATE_LIMIT_COOLDOWN_SECONDS=300
GLM_BATCH_SPILLOVER_ENABLED=true
GLM_BATCH_SPILLOVER_BACKLOG_FACTOR=2
GLM_BATCH_CAPSULES_ENABLED=true
GLM_BATCH_COGNITIVE_ANALYSIS_ENABLED=true

# ---------------------------------------------------------------------------
# Social Login [OPTIONAL - fill when ready for app store]
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------------------------------------------------------------------------
# Email / SMTP [MUST CHANGE if EMAIL_ENABLED=true]
# ---------------------------------------------------------------------------
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Sparkle

# ---------------------------------------------------------------------------
# gRPC Server (Agent Service) [MUST CHANGE for TLS]
# ---------------------------------------------------------------------------
GRPC_PORT=50051
GRPC_ENABLE_REFLECTION=False
GRPC_REQUIRE_TLS=false
GRPC_TLS_CERT_PATH=/run/secrets/grpc_server.crt
GRPC_TLS_KEY_PATH=/run/secrets/grpc_server.key
GRPC_TLS_CA_CERT_PATH=

# gRPC Client (Gateway -> Agent) [RECOMMENDED for mTLS]
AGENT_TLS_ENABLED=false
# AGENT_TLS_CA_CERT=/run/secrets/grpc_ca.crt
# AGENT_TLS_CLIENT_CERT=/run/secrets/grpc_client.crt
# AGENT_TLS_CLIENT_KEY=/run/secrets/grpc_client.key
# AGENT_TLS_SERVER_NAME=sparkle-agent
# AGENT_TLS_INSECURE=false

# ---------------------------------------------------------------------------
# Service URLs [MUST CHANGE]
# ---------------------------------------------------------------------------
# [MUST CHANGE] Production HTTPS URL for deeplinks, CORS, and email links.
# Must be HTTPS. The settings validator rejects non-HTTPS values.
PRODUCTION_URL=https://sparkle.example.com
BACKEND_URL=http://backend:8000
GATEWAY_INTERNAL_URL=http://gateway_blue:8080

# CORS origins (JSON array format or comma-separated)
# [MUST CHANGE] Must contain only HTTPS origins in production
BACKEND_CORS_ORIGINS=["https://sparkle.example.com"]

# ---------------------------------------------------------------------------
# Gateway Security  [MUST CHANGE]
# ---------------------------------------------------------------------------
# [MUST CHANGE] Trusted proxy IPs/CIDRs. Set to your load balancer IP(s).
# Comma-separated. Required in production — gateway crashes without it.
TRUSTED_PROXIES=10.0.0.1/32
# [MUST CHANGE] Comma-separated allowed CORS origins for the gateway.
ALLOWED_ORIGINS=https://sparkle.example.com,https://app.sparkle.example.com
# Reject tokens when Redis is unavailable (fail-closed strategy)
REDIS_FAIL_CLOSED=true
# Disable passing auth tokens via WebSocket query strings in production
ALLOW_WS_QUERY_TOKEN=false

# WebSocket
WS_ALLOW_QUERY_TOKEN=false

# ---------------------------------------------------------------------------
# Container Identity [OPTIONAL]
# ---------------------------------------------------------------------------
SPARKLE_APP_UID=10001
SPARKLE_APP_GID=10001

# ---------------------------------------------------------------------------
# OpenTelemetry [OPTIONAL]
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# ---------------------------------------------------------------------------
# Sentry [OPTIONAL - recommended for crash reporting]
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Image Tags for docker-compose.prod.yml [RECOMMENDED]
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
GATEWAY_IMAGE=ghcr.io/<your-org>/sparkle-gateway
BACKEND_IMAGE=ghcr.io/<your-org>/sparkle-backend

# ---------------------------------------------------------------------------
# Chaos Engineering [OPTIONAL - keep disabled in production]
# ---------------------------------------------------------------------------
CHAOS_ENABLED=false
CHAOS_ALLOW_PROD=false

# ---------------------------------------------------------------------------
# Observability Stack [MUST CHANGE]
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate-strong-grafana-password>

# Alertmanager [MUST CHANGE - webhook URLs required for production]
# The docker-compose.prod.yml enforces these via ?-interpolation.
ALERTMANAGER_DEFAULT_WEBHOOK_URL=<your-default-webhook-url>
ALERTMANAGER_CRITICAL_WEBHOOK_URL=<your-critical-webhook-url>
ALERTMANAGER_WARNING_WEBHOOK_URL=<your-warning-webhook-url>
ALERTMANAGER_EMAIL_TO=ops@example.com
ALERTMANAGER_EMAIL_FROM=sparkle-alerts@example.com
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Aurora Adaptive Kernel (tri-state: off | shadow | live)
# ---------------------------------------------------------------------------
# All switches default to "live" in production. Adjust individually for
# staged rollouts. See scripts/stage{N}/drill_transitions.sh for testing.

AURORA_DEFAULT_MODE=live
ENABLE_AURORA_RUNTIME_V1=true

# AI Four-Phase Launch switches
ENABLE_CONTEXT_FOCUSING=true
ENABLE_CONTEXT_SEMANTIC_GATING=true
ENABLE_CONTEXT_BRIEFING=true
ENABLE_CONTEXT_FOCUS_METADATA=true
ENABLE_SESSION_FEEDBACK_ADAPTATION=true
ENABLE_ADAPTIVE_PRESENTATION=true
ENABLE_STRUCTURED_NEXT_ACTIONS=true
ENABLE_BLOCKED_TEMPERATURE=true
ENABLE_UX_PRESENTATION_METADATA=true
ENABLE_PERCEPTIBLE_INTELLIGENCE=true
ENABLE_PROACTIVE_INSIGHTS=true
ENABLE_PLAN_REASONING_SUMMARY=true
ENABLE_WEEKLY_LEARNING_REPORT=true
ENABLE_PROGRESS_COMPARISONS=true

# Aurora boolean switches (non-MODE)
SPARKLE_MEMORY_INFERRED_WRITE_ENABLED=true
SPARKLE_MEMORY_INFERRED_DRY_RUN_ENABLED=false
SPARKLE_AGGREGATOR_ENABLED=true
SPARKLE_ROUTER_SOCIAL_CONTEXT_READ_ENABLED=true
SPARKLE_ROUTER_USE_AGGREGATOR_PROVIDER=true
SPARKLE_PUSH_POLICY_ENABLED=true
SPARKLE_PUSH_DELIVERY_ENABLED=true
SPARKLE_WORKING_MEMORY_ENABLED=true
SPARKLE_LLM_EXTRACTOR_ENABLED=true
SPARKLE_LLM_EXTRACTOR_DRY_RUN_ENABLED=false
SPARKLE_CONSOLIDATION_ENABLED=true
SPARKLE_CONFLICT_RESOLVER_SHADOW_MODE=false
SPARKLE_ROUTER_SUFFICIENCY_BRANCH_ENABLED=true
SPARKLE_SKILL_EXTRACT_ENABLED=true
SPARKLE_SKILL_SELECTION_ENABLED=true
SPARKLE_SKILL_SHARE_ENABLED=true
SPARKLE_SKILL_SHARE_MOCK_REVIEW_ENABLED=false
SPARKLE_PROMPT_SOCIAL_CONTEXT_RENDER_ENABLED=true

# Stage 18 - Push System
AURORA_STAGE18_AGGREGATOR_MODE=live
AURORA_STAGE18_PUSH_POLICY_MODE=live
AURORA_STAGE18_PUSH_DELIVERY_MODE=live

# Stage 19 - Working Memory
AURORA_STAGE19_WORKING_MEMORY_MODE=live
AURORA_STAGE19_LLM_EXTRACTOR_MODE=live
AURORA_STAGE19_CONSOLIDATION_MODE=live

# Stage 21 - Skill Store
AURORA_STAGE21_SKILL_STORE_MODE=live
AURORA_STAGE21_SKILL_SELECTION_MODE=live
AURORA_STAGE21_SKILL_SHARE_MODE=live

# Stage 23 - Bayesian Learner
AURORA_BAYESIAN_MODE=live
AURORA_BAYESIAN_LIVE_CANARY_PERCENT=5
AURORA_BAYESIAN_TTL_DAYS=30

# Stage 24 - Policy Compiler
AURORA_POLICY_COMPILER_MODE=live
AURORA_POLICY_DAILY_BUDGET=2
AURORA_POLICY_COOLDOWN_HOURS=24

# Stage 25 - Reflection Wire
AURORA_REFLECTION_WIRE_MODE=live
AURORA_REFLECTION_CONTEXT_LIMIT=20
AURORA_REFLECTION_CONTEXT_MAX_TOKENS=800
AURORA_REFLECTION_TRIGGER_TOO_DIFFICULT=true
AURORA_REFLECTION_TRIGGER_UNCLEAR=true
AURORA_REFLECTION_TRIGGER_ABANDONED=true
AURORA_REFLECTION_TRIGGER_INTERVENTION_INEFFECTIVE=true
AURORA_REFLECTION_TRIGGER_PLAN_STALL=true
AURORA_REFLECTION_TRIGGER_OVERLOAD=true

# Stage 26 - Scene Model
AURORA_SCENE_MODE=live
AURORA_SCENE_SIMILARITY_THRESHOLD=0.75
AURORA_SCENE_TIME_WINDOW_HOURS=72
AURORA_SCENE_QUALITY_THRESHOLD=0.6

# Stage 27 - Foresight Engine
AURORA_FORESIGHT_MODE=live
AURORA_FORESIGHT_ATTRACTOR=live
AURORA_FORESIGHT_DEVIATION=live
AURORA_FORESIGHT_JITAI=live
AURORA_FORESIGHT_CACHE_TTL_SECONDS=60
AURORA_FORESIGHT_ATTRACTOR_ALPHA=0.1
AURORA_FORESIGHT_ATTRACTOR_MIN_CONFIDENCE=0.3
AURORA_FORESIGHT_DEVIATION_Z_THRESHOLD=1.5
AURORA_FORESIGHT_JITAI_DAILY_BUDGET=3
AURORA_FORESIGHT_JITAI_COOLDOWN_HOURS=24
AURORA_FORESIGHT_JITAI_MISFIRE_THRESHOLD=0.15

# Stage 28 - Traits
AURORA_TRAITS_MODE=live
AURORA_TRAITS_NLP_MODE=live
AURORA_TRAITS_COLDSTART_MODE=live
AURORA_TRAITS_NLP_COOLDOWN_HOURS=24
AURORA_TRAITS_NLP_BIAS_THRESHOLD=0.10
AURORA_TRAITS_NLP_MAX_DAYS=30
AURORA_TRAITS_NLP_MAX_COST_USD=0.003
AURORA_TRAITS_NLP_P95_MS_BUDGET=800

# Stage 29 - SRL
AURORA_SRL_MODE=live
AURORA_SRL_TRACKER_MODE=live
AURORA_SRL_BRIDGE_MODE=live
AURORA_SRL_SCAFFOLDING_CONSUME_MODE=live
AURORA_SRL_EVENT_LAG_P95_THRESHOLD_SECONDS=5.0
AURORA_SRL_MISJUDGMENT_THRESHOLD=0.20
AURORA_SRL_TRACKER_P95_MS_BUDGET=20
AURORA_SRL_AGGREGATOR_TTL_SECONDS=15

# Stage 30 - Metacognition
AURORA_METACOG_MODE=live
AURORA_METACOG_DASHBOARD_MODE=live
AURORA_METACOG_PROCESS_SCAFFOLDING_MODE=live
AURORA_METACOG_FSM_COMBINE_MODE=live
AURORA_METACOG_CACHE_TTL_SECONDS=60
AURORA_METACOG_MIN_SAMPLE_SIZE=20
AURORA_METACOG_PROCESS_TRIGGER_ABS_BIAS=0.30
AURORA_METACOG_PROCESS_COOLDOWN_HOURS=72
AURORA_METACOG_P95_MS_BUDGET=100
AURORA_METACOG_PROXY_REVISION_FREQUENCY=live
AURORA_METACOG_PROXY_SELF_CORRECTION_RATE=live
AURORA_METACOG_PROXY_QUESTION_TO_STATEMENT_RATIO=live
AURORA_METACOG_PROXY_TIME_TO_FIRST_ACTION=live
AURORA_METACOG_PROXY_COMPLETION_VS_ESTIMATE_DELTA_SIGN=live
AURORA_IDIOGRAPHIC_MODE=live
AURORA_IDIOGRAPHIC_TTL_SECONDS=300

# Dual-Core Router
AURORA_DUAL_CORE_ROUTER_MODE=live

# Stage 33
AURORA_STAGE33_MODE=live
AURORA_STAGE33_SOCIAL_MODE=live
AURORA_STAGE33_SRL_MODE=live
AURORA_STAGE33_WM_PROMPT_MODE=live
AURORA_STAGE33_EVENTS_MODE=live

# Stage 34
AURORA_STAGE34_MODE=live
AURORA_STAGE34_ERROR_BRIDGE_MODE=live
