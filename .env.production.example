# =============================================================================
# Sparkle Production Environment Template
# =============================================================================
# Copy to .env on the production server and fill ALL values marked REQUIRED.
# Run: python scripts/check_production_secrets.py to validate (if available).
#
# DO NOT commit this file with real secrets. Add .env to .gitignore.
# =============================================================================

# ─── CRITICAL PRODUCTION OVERRIDES ──────────────────────────────────────────

ENVIRONMENT=production
DEBUG=False
REDIS_FAIL_CLOSED=true

# ─── SECRETS (REQUIRED — generate with: openssl rand -hex 32) ───────────────

SECRET_KEY=<generate 64-char hex>
JWT_SECRET=<generate 64-char hex>
POSTGRES_PASSWORD=<generate strong password>
SPARKLE_GATEWAY_DB_PASSWORD=<generate strong password>
SPARKLE_ENGINE_DB_PASSWORD=<generate strong password>
SPARKLE_CELERY_DB_PASSWORD=<generate strong password>
SPARKLE_READONLY_DB_PASSWORD=<generate strong password>
REDIS_PASSWORD=<generate strong password>
SPARKLE_GATEWAY_REDIS_PASSWORD=<generate strong password>
SPARKLE_ENGINE_REDIS_PASSWORD=<generate strong password>
SPARKLE_CELERY_REDIS_PASSWORD=<generate strong password>
MINIO_ROOT_PASSWORD=<generate strong password>
MINIO_UPLOADS_SECRET_KEY=<generate strong password>
MINIO_EXPORTS_SECRET_KEY=<generate strong password>
MINIO_BACKUPS_SECRET_KEY=<generate strong password>
INTERNAL_API_KEY=<generate 64-char hex>
ADMIN_SECRET=<generate 64-char hex>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate strong password>

# ─── DATABASE ────────────────────────────────────────────────────────────────

POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@sparkle_db:5432/sparkle
SPARKLE_RBAC_ENABLED=true
SPARKLE_GATEWAY_DATABASE_URL=postgresql://sparkle_gateway:${SPARKLE_GATEWAY_DB_PASSWORD}@sparkle_db:5432/sparkle?sslmode=require
SPARKLE_ENGINE_DATABASE_URL=postgresql+asyncpg://sparkle_engine:${SPARKLE_ENGINE_DB_PASSWORD}@sparkle_db:5432/sparkle?sslmode=require
SPARKLE_CELERY_DATABASE_URL=postgresql+asyncpg://sparkle_celery:${SPARKLE_CELERY_DB_PASSWORD}@sparkle_db:5432/sparkle?sslmode=require
SPARKLE_READONLY_DATABASE_URL=postgresql://sparkle_readonly:${SPARKLE_READONLY_DB_PASSWORD}@sparkle_db:5432/sparkle?sslmode=require

DB_HOST=sparkle_db
DB_PORT=5432
DB_NAME=sparkle
DB_USER=postgres
DB_PASSWORD=${POSTGRES_PASSWORD}

# PostgreSQL tuning (adjust based on server RAM)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_WAL_SIZE=2GB

# ─── REDIS ───────────────────────────────────────────────────────────────────

REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@sparkle_redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@sparkle_redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@sparkle_redis:6379/2
SPARKLE_GATEWAY_REDIS_URL=redis://gateway:${SPARKLE_GATEWAY_REDIS_PASSWORD}@sparkle_redis:6379/0
SPARKLE_ENGINE_REDIS_URL=redis://engine:${SPARKLE_ENGINE_REDIS_PASSWORD}@sparkle_redis:6379/0
SPARKLE_CELERY_REDIS_URL=redis://celery:${SPARKLE_CELERY_REDIS_PASSWORD}@sparkle_redis:6379/1
SPARKLE_CELERY_BROKER_URL=redis://celery:${SPARKLE_CELERY_REDIS_PASSWORD}@sparkle_redis:6379/1
SPARKLE_CELERY_RESULT_BACKEND=redis://celery:${SPARKLE_CELERY_REDIS_PASSWORD}@sparkle_redis:6379/2

# ─── MINIO (File Storage) ───────────────────────────────────────────────────

MINIO_ROOT_USER=<choose a username>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=sparkle-files
MINIO_UPLOADS_BUCKET=sparkle-uploads
MINIO_EXPORTS_BUCKET=sparkle-exports
MINIO_BACKUPS_BUCKET=sparkle-backups
MINIO_UPLOADS_ACCESS_KEY=sparkle_uploads
MINIO_EXPORTS_ACCESS_KEY=sparkle_exports
MINIO_BACKUPS_ACCESS_KEY=sparkle_backups
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true

# ─── JWT ─────────────────────────────────────────────────────────────────────

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=RS256
# RSA key pair for RS256 JWT signing (required when ALGORITHM=RS256)
# Generate: openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── CORS (REQUIRED — restrict to actual domain) ────────────────────────────

BACKEND_CORS_ORIGINS=["https://<your-domain>"]

# ─── LLM PROVIDERS (REQUIRED — at least one provider must be configured) ────

# Primary: Qwen (DashScope)
LLM_PROVIDER=qwen
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<your qwen api key>
LLM_MODEL_NAME=qwen-plus
LLM_REASON_MODEL_NAME=deepseek-reasoner

# DeepSeek
DEEPSEEK_API_KEY=<your deepseek api key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASON_MODEL=deepseek-v4-pro

# Zhipu GLM
ZHIPU_API_KEY=<your zhipu api key>
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Embedding
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=<your dashscope api key>
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ─── SOCIAL LOGIN (fill when ready for app store) ───────────────────────────

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ─── PUSH NOTIFICATIONS (JPush for China) ───────────────────────────────────

# JPUSH_APP_KEY=<your jpush app key>
# JPUSH_MASTER_SECRET=<your jpush master secret>

# ─── EMAIL (password reset, verification) ────────────────────────────────────

EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<your smtp username>
SMTP_PASSWORD=<your smtp password>
EMAIL_FROM=no-reply@<your-domain>
EMAIL_FROM_NAME=Sparkle

# ─── SENTRY (crash reporting — recommended) ─────────────────────────────────

SENTRY_DSN=<your sentry dsn>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── PRODUCTION URL ─────────────────────────────────────────────────────────

PRODUCTION_URL=https://<your-domain>

# ─── BACKEND_URL (internal Docker network) ──────────────────────────────────

BACKEND_URL=http://backend:8000

# ─── IMAGE TAGS ─────────────────────────────────────────────────────────────

IMAGE_TAG=latest
GATEWAY_IMAGE=ghcr.io/your-org/sparkle-gateway
BACKEND_IMAGE=ghcr.io/your-org/sparkle-backend

# ─── CONTAINER IDENTITY ─────────────────────────────────────────────────────

SPARKLE_APP_UID=10001
SPARKLE_APP_GID=10001

# ─── FILE SERVICE ───────────────────────────────────────────────────────────

FILE_MAX_UPLOAD_SIZE=52428800
FILE_PRESIGN_EXPIRES_SECONDS=420
FILE_GC_INTERVAL_MINUTES=60
FILE_GC_GRACE_HOURS=24
FILE_GC_BATCH_SIZE=200

# ─── MONITORING ─────────────────────────────────────────────────────────────

OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
ALERTMANAGER_EMAIL_TO=ops@<your-domain>
ALERTMANAGER_EMAIL_FROM=sparkle-alerts@<your-domain>

# Alertmanager webhook receivers — REQUIRED for production alerts.
# The docker-compose.prod.yml enforces these (fails startup if unset).
# Use your real alert receiver URLs (Slack webhook, PagerDuty, DingTalk, custom, etc.).
ALERTMANAGER_DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERTMANAGER_CRITICAL_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERTMANAGER_WARNING_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── gRPC TLS ────────────────────────────────────────────────────────────────
# Python Engine side (GRPC_REQUIRE_TLS): When true, the Python gRPC server loads
#   TLS certs from GRPC_TLS_CERT_PATH / GRPC_TLS_KEY_PATH.
# Go Gateway side (AGENT_TLS_ENABLED): Separate toggle — must ALSO be set for the
#   gateway to dial the agent over TLS. Both sides must agree.
#   Set AGENT_TLS_ENABLED=true and provide AGENT_TLS_CA_CERT + AGENT_TLS_CLIENT_*
#   when Gateway and Engine run on separate hosts/networks.
#   Generate certs: scripts/generate_grpc_certs.sh (if available)

GRPC_REQUIRE_TLS=true
AGENT_TLS_ENABLED=false
# AGENT_TLS_CA_CERT=/run/secrets/grpc_ca.crt
# AGENT_TLS_CLIENT_CERT=/run/secrets/grpc_client.crt
# AGENT_TLS_CLIENT_KEY=/run/secrets/grpc_client.key
# AGENT_TLS_SERVER_NAME=sparkle-agent

# ─── CHAOS ENGINEERING ──────────────────────────────────────────────────────

CHAOS_ENABLED=false
CHAOS_ALLOW_PROD=false

# ─── STT (Speech to Text) ───────────────────────────────────────────────────

STT_PROVIDER=xunfei
STT_BACKUP_PROVIDER=zhipu
XUNFEI_APP_ID=<your xunfei app id>
XUNFEI_API_KEY=<your xunfei key>
XUNFEI_API_SECRET=<your xunfei secret>

# ─── GLM Batch ──────────────────────────────────────────────────────────────

GLM_BATCH_ENABLED=true
GLM_BATCH_MAX_CONCURRENCY=6

# ─── Aurora Kill Switches ───────────────────────────────────────────────────

# ─── AURORA ADAPTIVE KERNEL ────────────────────────────────────────────────
# All Aurora switches use the tri-state protocol: off → shadow → live.
# New features default to "shadow" in production for safe rollout.
# See scripts/stage{N}/drill_transitions.sh for transition testing.

# OpenClaw delegated execution
# docker-compose injects host.docker.internal routes for containers automatically.
OPENCLAW_ENABLED=true

OPENCLAW_TRANSPORT=gateway_ws

OPENCLAW_DEFAULT_AGENT_ID=main

OPENCLAW_DEFAULT_TIMEOUT_SECONDS=300

OPENCLAW_MAX_CONCURRENT_RUNS=3

# gRPC TLS (required when ENVIRONMENT=production for agent service role)
GRPC_TLS_CERT_PATH=/run/secrets/grpc_server.crt

GRPC_TLS_KEY_PATH=/run/secrets/grpc_server.key

# AI Four-Phase Launch
ENABLE_CONTEXT_FOCUSING=true

ENABLE_CONTEXT_SEMANTIC_GATING=true

ENABLE_CONTEXT_BRIEFING=true

ENABLE_CONTEXT_FOCUS_METADATA=true

ENABLE_SESSION_FEEDBACK_ADAPTATION=true

ENABLE_ADAPTIVE_PRESENTATION=true

ENABLE_STRUCTURED_NEXT_ACTIONS=true

ENABLE_BLOCKED_TEMPERATURE=true

ENABLE_UX_PRESENTATION_METADATA=true

ENABLE_PERCEPTIBLE_INTELLIGENCE=true

ENABLE_PROACTIVE_INSIGHTS=true

ENABLE_PLAN_REASONING_SUMMARY=true

ENABLE_WEEKLY_LEARNING_REPORT=true

ENABLE_PROGRESS_COMPARISONS=true

AURORA_BAYESIAN_MODE=shadow

AURORA_POLICY_COMPILER_MODE=shadow

AURORA_REFLECTION_WIRE_MODE=shadow

AURORA_SCENE_MODE=shadow

AURORA_FORESIGHT_MODE=shadow

AURORA_TRAITS_MODE=shadow

AURORA_TRAITS_NLP_MODE=shadow

AURORA_TRAITS_COLDSTART_MODE=shadow

AURORA_SRL_MODE=shadow

AURORA_SRL_TRACKER_MODE=shadow

AURORA_SRL_BRIDGE_MODE=shadow

AURORA_SRL_SCAFFOLDING_CONSUME_MODE=shadow

AURORA_METACOG_MODE=shadow

AURORA_METACOG_DASHBOARD_MODE=shadow

AURORA_METACOG_PROCESS_SCAFFOLDING_MODE=shadow

AURORA_METACOG_FSM_COMBINE_MODE=shadow

AURORA_IDIOGRAPHIC_MODE=shadow

AURORA_DOC_CONTEXT_DOCUMENT_CONTEXT_INJECTION_MODE=shadow

# Aurora non-MODE parameters (thresholds, budgets, cooldowns, boolean triggers)
# Stage 23 - Bayesian Learner
AURORA_BAYESIAN_LIVE_CANARY_PERCENT=5

AURORA_BAYESIAN_TTL_DAYS=30

# Stage 24 - Policy Compiler
AURORA_POLICY_DAILY_BUDGET=2

AURORA_POLICY_COOLDOWN_HOURS=24

# Stage 25 - Reflection Wire
AURORA_REFLECTION_CONTEXT_LIMIT=20

AURORA_REFLECTION_CONTEXT_MAX_TOKENS=800

AURORA_REFLECTION_TRIGGER_TOO_DIFFICULT=true

AURORA_REFLECTION_TRIGGER_UNCLEAR=true

AURORA_REFLECTION_TRIGGER_ABANDONED=true

AURORA_REFLECTION_TRIGGER_INTERVENTION_INEFFECTIVE=true

AURORA_REFLECTION_TRIGGER_PLAN_STALL=true

AURORA_REFLECTION_TRIGGER_OVERLOAD=true

# Stage 26 - Scene Model
AURORA_SCENE_SIMILARITY_THRESHOLD=0.75

AURORA_SCENE_TIME_WINDOW_HOURS=72

AURORA_SCENE_QUALITY_THRESHOLD=0.6

# Stage 27 - Foresight Engine
AURORA_FORESIGHT_ATTRACTOR=live

AURORA_FORESIGHT_DEVIATION=live

AURORA_FORESIGHT_JITAI=live

AURORA_FORESIGHT_CACHE_TTL_SECONDS=60

AURORA_FORESIGHT_ATTRACTOR_ALPHA=0.1

AURORA_FORESIGHT_ATTRACTOR_MIN_CONFIDENCE=0.3

AURORA_FORESIGHT_DEVIATION_Z_THRESHOLD=1.5

AURORA_FORESIGHT_JITAI_DAILY_BUDGET=3

AURORA_FORESIGHT_JITAI_COOLDOWN_HOURS=24

AURORA_FORESIGHT_JITAI_MISFIRE_THRESHOLD=0.15

# Stage 28 - Traits
AURORA_TRAITS_NLP_COOLDOWN_HOURS=24

AURORA_TRAITS_NLP_BIAS_THRESHOLD=0.10

AURORA_TRAITS_NLP_MAX_DAYS=30

AURORA_TRAITS_NLP_MAX_COST_USD=0.003

# Stage 29 - SRL
AURORA_SRL_MISJUDGMENT_THRESHOLD=0.20

AURORA_SRL_AGGREGATOR_TTL_SECONDS=15

# Stage 30 - Metacognition
AURORA_METACOG_CACHE_TTL_SECONDS=60

AURORA_METACOG_MIN_SAMPLE_SIZE=20

AURORA_METACOG_PROCESS_TRIGGER_ABS_BIAS=0.30

AURORA_METACOG_PROCESS_COOLDOWN_HOURS=72

AURORA_METACOG_PROXY_REVISION_FREQUENCY=live

AURORA_METACOG_PROXY_SELF_CORRECTION_RATE=live

AURORA_METACOG_PROXY_QUESTION_TO_STATEMENT_RATIO=live

AURORA_METACOG_PROXY_TIME_TO_FIRST_ACTION=live

AURORA_METACOG_PROXY_COMPLETION_VS_ESTIMATE_DELTA_SIGN=live

AURORA_IDIOGRAPHIC_TTL_SECONDS=300

# Stage 37 - LLM Safety
# Stage 38 - Error Replan + Push Scheduler
# Stage 39 - Scaffolding + Cognitive Load + Galaxy
# Stage 40 - Calendar
# Document Context
AURORA_DOC_CONTEXT_MODE=shadow

AURORA_DOC_CONTEXT_AGGRESSIVE_BUDGET_TOKENS=2200

AURORA_DOC_CONTEXT_SELECTIVE_BUDGET_TOKENS=900

AURORA_DOC_CONTEXT_AMBIGUOUS_BUDGET_TOKENS=500

# Privacy
AURORA_PRIVACY_PII_REDACTION_MODE=shadow
