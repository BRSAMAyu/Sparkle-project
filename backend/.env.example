# Application Settings
APP_NAME=Sparkle
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev_secret_key_change_in_production

# Database Settings (canonical)
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@sparkle_db:5432/sparkle

# Redis Settings
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@sparkle_redis:6379/0

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# LLM Service (DeepSeek / Qwen / OpenAI)
LLM_PROVIDER=qwen
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_qwen_api_key
LLM_MODEL_NAME=qwen-turbo
LLM_REASON_MODEL_NAME=deepseek-reasoner

# DeepSeek Specific
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DashScope (Aliyun)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# SiliconFlow
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# Embedding Service
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=1024
RERANK_PROVIDER=siliconflow
RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# STT (Speech to Text) Service
STT_PROVIDER=xunfei
STT_ENHANCE_ENABLED=true

# XunFei (科大讯飞) STT Configuration
XUNFEI_API_KEY=your_xunfei_api_key_here
XUNFEI_API_SECRET=your_xunfei_api_secret_here
XUNFEI_STT_DOMAIN=iat
XUNFEI_STT_LANGUAGE=zh-CN
XUNFEI_STT_SAMPLE_RATE=16000
XUNFEI_STT_MAX_AUDIO_DURATION=60
XUNFEI_STT_EOS_MS=6000

# Internal API
INTERNAL_API_KEY=dev_internal_key
GATEWAY_INTERNAL_URL=http://localhost:8080

# gRPC Server
GRPC_PORT=50051
GRPC_ENABLE_REFLECTION=True

# Hunyuan Translation (via SiliconFlow)
# HUNYUAN_API_KEY=your_siliconflow_api_key
# HUNYUAN_BASE_URL=https://api.siliconflow.cn/v1
# HUNYUAN_CHAT_MODEL=tencent/Hunyuan-A13B-Instruct
# HUNYUAN_REASON_MODEL=tencent/Hunyuan-A13B-Instruct
# LLM_PROVIDER=hunyuan  # 可选：设置为默认提供商

# DeepSeek-OCR (Document Cleaning via SiliconFlow)
# SILICONFLOW_API_KEY=your_siliconflow_api_key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
