# Application Settings
APP_NAME=Sparkle
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your_secret_key_here

# Database Settings (canonical)
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@sparkle_db:5432/sparkle

# Redis Settings
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@sparkle_redis:6379/0

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Social Login — Google
GOOGLE_CLIENT_ID=your_google_client_id

# Social Login — Apple
APPLE_CLIENT_ID=your_apple_client_id

# Social Login — WeChat
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# Email Service
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Sparkle

# LLM Service (DeepSeek / Qwen / OpenAI)
LLM_PROVIDER=qwen
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_qwen_api_key
LLM_MODEL_NAME=qwen-plus
LLM_REASON_MODEL_NAME=deepseek-reasoner
# LLM Tier Routing (comma-separated model keys from LLMRouter)
LLM_TIER_FREE_FAST=
LLM_TIER_FREE_REASONING=
LLM_TIER_FAST=
LLM_TIER_STANDARD=
LLM_TIER_REASONING=
LLM_TIER_SPECIALIST=

# XiaoMi MIMO Configuration (快速响应)
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_CHAT_MODEL=mimo-v2-flash
XIAOMI_TEMPERATURE=0.3

# DeepSeek Specific
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Zhipu GLM Configuration
# GLM-4.7-Flash: 30B级模型，支持思考模式，面向Agentic Coding场景
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_CHAT_MODEL=glm-4.7
ZHIPU_TOOLS_MODEL=glm-4.7
ZHIPU_FLASH_MODEL=glm-4.7-flashx
GLM_4_7_FLASH_MODEL=glm-4.7-flash
ZHIPU_TEMPERATURE=0.3
ZHIPU_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_OCR_MODEL=glm-ocr
ZHIPU_OCR_TIMEOUT_SECONDS=120
OCR_PROVIDER=zhipu
OCR_BACKUP_PROVIDER=siliconflow

# SiliconFlow Configuration (Embedding/Rerank/翻译等)
# 提供专用模型服务，通过 SPECIALIST tier 访问
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SILICONFLOW_OCR_TIMEOUT_SECONDS=120

# Hunyuan Translation (via SiliconFlow)
# 机器翻译专用模型
HUNYUAN_API_KEY=your_siliconflow_api_key
HUNYUAN_BASE_URL=https://api.siliconflow.cn/v1
HUNYUAN_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B
SILICONFLOW_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B
TRANSLATION_PRIMARY_PROVIDER=hunyuan
TRANSLATION_BACKUP_PROVIDER=siliconflow
TRANSLATION_PROVIDER_TIMEOUT_SECONDS=30

# DashScope (Aliyun)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL_COMPATIBLE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_REASON_MODEL=qwen-plus
DASHSCOPE_TEMPERATURE=0.7
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# SiliconFlow
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# Embedding Service
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BACKUP_PROVIDER=siliconflow
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_PROVIDER=dashscope
RERANK_BACKUP_PROVIDER=siliconflow
RERANK_MODEL=qwen3-rerank

# STT (Speech to Text) Service
STT_PROVIDER=xunfei
STT_BACKUP_PROVIDER=zhipu
STT_ENHANCE_ENABLED=true

# GLM Batch
GLM_BATCH_ENABLED=true
GLM_BATCH_QUEUE=glm_batch
GLM_BATCH_MAX_CONCURRENCY=2
GLM_BATCH_CAPSULES_ENABLED=true
GLM_BATCH_COGNITIVE_ANALYSIS_ENABLED=true

# XunFei (科大讯飞) STT Configuration
XUNFEI_APP_ID=your_xunfei_app_id_here
XUNFEI_API_KEY=your_xunfei_api_key_here
XUNFEI_API_SECRET=your_xunfei_api_secret_here
XUNFEI_STT_DOMAIN=slm
XUNFEI_STT_LANGUAGE=zh-CN
XUNFEI_STT_SAMPLE_RATE=16000
XUNFEI_STT_MAX_AUDIO_DURATION=60
XUNFEI_STT_EOS_MS=6000

# WebSocket Settings
WS_ALLOW_QUERY_TOKEN=true

# Internal API
INTERNAL_API_KEY=your_internal_api_key
GATEWAY_INTERNAL_URL=http://localhost:8080

# gRPC Server
GRPC_PORT=50051
GRPC_ENABLE_REFLECTION=True

# AI Four-Phase Launch
ENABLE_CONTEXT_FOCUSING=true
ENABLE_CONTEXT_SEMANTIC_GATING=true
ENABLE_CONTEXT_BRIEFING=true
ENABLE_CONTEXT_FOCUS_METADATA=true
ENABLE_SESSION_FEEDBACK_ADAPTATION=true
ENABLE_ADAPTIVE_PRESENTATION=true
ENABLE_STRUCTURED_NEXT_ACTIONS=true
ENABLE_BLOCKED_TEMPERATURE=true
ENABLE_UX_PRESENTATION_METADATA=true
ENABLE_PERCEPTIBLE_INTELLIGENCE=true
ENABLE_PROACTIVE_INSIGHTS=true
ENABLE_PLAN_REASONING_SUMMARY=true
ENABLE_WEEKLY_LEARNING_REPORT=true
ENABLE_PROGRESS_COMPARISONS=true

# Hunyuan Translation (via SiliconFlow)
# HUNYUAN_API_KEY=your_siliconflow_api_key
# HUNYUAN_BASE_URL=https://api.siliconflow.cn/v1
# HUNYUAN_TRANSLATE_MODEL=tencent/Hunyuan-MT-7B

# GLM OCR (Document Cleaning via Zhipu)
# ZHIPU_API_KEY=your_zhipu_api_key
# ZHIPU_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_OCR_MODEL=glm-ocr
