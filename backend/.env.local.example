# Backend local development environment.

APP_NAME=Sparkle
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev_secret_key_change_in_production

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/sparkle

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

LLM_PROVIDER=qwen
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_dashscope_api_key
LLM_MODEL_NAME=qwen-plus
LLM_REASON_MODEL_NAME=qwen-plus

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

DASHSCOPE_API_KEY=your_dashscope_api_key
SILICONFLOW_API_KEY=your_siliconflow_api_key
ZHIPU_API_KEY=your_zhipu_api_key
XIAOMI_MIMO_API_KEY=your_mimo_api_key

STT_PROVIDER=xunfei
STT_ENHANCE_ENABLED=true
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

WS_ALLOW_QUERY_TOKEN=true
INTERNAL_API_KEY=dev_internal_key
GATEWAY_INTERNAL_URL=http://localhost:8080
GRPC_PORT=50051
GRPC_ENABLE_REFLECTION=True

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
JWT_SECRET=dev_jwt_secret_change_me
