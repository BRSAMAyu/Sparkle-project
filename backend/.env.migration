APP_NAME=Sparkle
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=dev-secret-key
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@sparkle_db:5432/sparkle
BACKEND_CORS_ORIGINS=["*"]
