APP_NAME=Sparkle
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=replace_with_migration_secret_key
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_postgres_password@localhost:5432/sparkle
BACKEND_CORS_ORIGINS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
LLM_API_BASE_URL=
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL_NAME=qwen-plus
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
REDIS_URL=redis://:replace_with_redis_password@localhost:6379/0
IDEMPOTENCY_STORE=redis
LOG_LEVEL=INFO
