      "available_tools": ["query_knowledge", "create_knowledge_node", "link_nodes"],
      "exit_conditions": ["prerequisite gaps are mapped", "must-know nodes are ordered"],
      "neighbors": ["day3_schedule_lock"],
      "transition_triggers": {
        "prereq_map_ready": "day3_schedule_lock"
      },
      "ux_mapping": {
        "frame": "mapping",
        "tone": "clear",
        "signal_terms": ["prerequisite_mastery"]
      },
      "default_interaction_model": "task_execution",
      "default_ux_intent": "routine"
    },
