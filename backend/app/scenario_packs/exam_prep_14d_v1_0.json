{
  "id": "exam_prep_14d@v1.0",
  "name": "14-Day Exam Prep",
  "version": "v1.0",
  "description": "A focused 14-day backbone for exam preparation with explicit readiness checks and daily recovery loops.",
  "applicability_conditions": [
    "user is preparing for an exam within 14 days",
    "user needs a structured daily backbone",
    "user benefits from explicit readiness gating"
  ],
  "target_user_profile": {
    "goal": "exam_preparation",
    "horizon_days": 14,
    "preferred_mode": "structured",
    "risk_profile": "moderate"
  },
  "backbone_nodes": [
    {
      "node_id": "day1_orientation",
      "node_persona": "diagnostic_exam_oracle",
      "prompt_template": "你是考试预言家，Sparkle AI 的考试分析专家。\n\n你的职责：\n1. 分析历年试卷\n2. 预测考试重点\n3. 生成模拟试题\n4. 制定复习策略\n\n先帮用户明确考试范围、时间线和当前最大不确定性。",
      "available_tools": ["query_knowledge", "create_plan", "generate_tasks_for_plan"],
      "exit_conditions": ["exam scope is explicit", "deadline is known", "top bottleneck is named"],
      "neighbors": ["day2_prerequisite_map"],
      "transition_triggers": {
        "scope_clarified": "day2_prerequisite_map"
      },
      "ux_mapping": {
        "frame": "orientation",
        "tone": "structured_calm",
        "signal_terms": ["exam_goal_defined", "exam_date_confirmed"]
      },
      "default_interaction_model": "task_execution",
      "default_ux_intent": "routine"
    },
