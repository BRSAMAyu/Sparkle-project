      "minimum_pass_required": true,
      "score_max_required": false,
      "common_mistakes": ["mistake.dm_relation_properties"],
      "recommended_action": "对同一关系矩阵逐条验证自反/对称/反对称/传递，并枚举三元集上的全部划分（等价关系计数）"
    },
