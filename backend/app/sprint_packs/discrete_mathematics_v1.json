{
  "id": "discrete_mathematics@v1",
  "name": "离散数学冲刺包",
  "version": "v1.0",
  "description": "面向离散数学期末考试的冲刺知识包，覆盖数理逻辑（命题/谓词）、集合与关系、函数与基数、图论（含欧拉图与哈密顿图）、树、组合计数与代数系统。",
  "subject": "离散数学",
  "aliases": ["离散", "离散数学", "discrete math", "discrete mathematics", "discrete_math"],
  "author": "sparkle-core",
  "created_at": "2026-09-22T00:00:00",
  "changelog": [
    "Initial release: 10 knowledge nodes (chapter-level core surface) for discrete mathematics sprint mode; aligns with NS-001 curriculum CH1-CH6 for diagnostic topic->galaxy-node mapping."
  ],
