    }
  ],
  "mistake_types": [
    {
      "mistake_id": "mistake.dm_truth_table",
      "label": "联结词与真值表混淆",
      "related_nodes": ["dm.propositional_logic"],
      "fix": "先列完整真值表再判重言/矛盾，不靠直觉跳步"
    },
    {
      "mistake_id": "mistake.dm_implication_direction",
      "label": "蕴含等值式方向记错",
      "related_nodes": ["dm.propositional_logic"],
      "fix": "记住 p→q 仅在 p 真q 假时为假，再用 ¬p∨q 交叉验证"
    },
    {
      "mistake_id": "mistake.dm_quantifier_negation",
      "label": "量词否定规则用错",
      "related_nodes": ["dm.predicate_logic"],
      "fix": "否定过量词时量词翻转且谓词取反：¬∀xF(x) ⇔ ∃x¬F(x)"
    },
    {
      "mistake_id": "mistake.dm_counting_overlap",
      "label": "计数重复或遗漏交集",
      "related_nodes": ["dm.set_theory", "dm.functions_cardinality", "dm.combinatorics"],
      "fix": "先写容斥公式再代数，排列与组合先判定是否计序"
    },
    {
      "mistake_id": "mistake.dm_relation_properties",
      "label": "关系性质判定混淆（对称/反对称）",
      "related_nodes": ["dm.binary_relations"],
      "fix": "用定义逐条验证，注意恒等关系同时满足对称与反对称"
    },
    {
      "mistake_id": "mistake.dm_euler_hamilton_mixup",
      "label": "欧拉/哈密顿条件混用",
      "related_nodes": ["dm.euler_hamilton", "dm.graph_basics"],
      "fix": "欧拉回路看边：连通且所有顶点偶度；哈密顿回路看点：过每点恰一次且无通用充要条件"
    },
    {
      "mistake_id": "mistake.dm_degree_parity",
      "label": "度数奇偶与握手定理误用",
      "related_nodes": ["dm.graph_basics", "dm.trees"],
      "fix": "先查度数总和是否为偶数，再检查最大度不超过 n-1"
    },
    {
      "mistake_id": "mistake.dm_group_axioms",
      "label": "群公理验证遗漏",
      "related_nodes": ["dm.algebraic_structures"],
      "fix": "按结合律、单位元、逆元的顺序逐条验证，缺一即非群"
    }
  ],
  "question_archetypes": [
    {
      "archetype_id": "dm.archetype.logic_truth_reasoning",
      "label": "命题/谓词逻辑推理题",
      "knowledge_nodes": ["dm.propositional_logic", "dm.predicate_logic"],
      "strategy": "先符号化，再列真值表或用量词否定、等值演算逐步推导"
    },
    {
      "archetype_id": "dm.archetype.relation_property",
      "label": "关系性质判定题",
      "knowledge_nodes": ["dm.binary_relations", "dm.set_theory"],
      "strategy": "对每条性质用定义验证，注意反例只需一个有序对"
    },
    {
      "archetype_id": "dm.archetype.function_counting",
      "label": "函数计数题",
      "knowledge_nodes": ["dm.functions_cardinality"],
      "strategy": "先定义务，再用乘法法则区分全函数/单射/双射计数"
    },
    {
      "archetype_id": "dm.archetype.graph_condition",
      "label": "图条件判定题",
      "knowledge_nodes": ["dm.graph_basics", "dm.euler_hamilton", "dm.trees"],
      "strategy": "从握手定理与度数奇偶入手，再区分欧拉（边）与哈密顿（点）条件"
    },
    {
      "archetype_id": "dm.archetype.counting_drill",
      "label": "组合计数题",
      "knowledge_nodes": ["dm.combinatorics"],
      "strategy": "判断计序与否选排列/组合，保证性论证优先考虑鸽巢原理"
    },
    {
      "archetype_id": "dm.archetype.algebra_structure",
      "label": "代数结构判定题",
      "knowledge_nodes": ["dm.algebraic_structures"],
      "strategy": "按结合律、单位元、逆元顺序验证群公理，用阶与生成元刻画循环群"
    }
  ],
