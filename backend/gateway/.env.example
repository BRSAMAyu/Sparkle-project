# Go Gateway Environment Configuration

# Server
PORT=8080
ENVIRONMENT=development

# Database
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@sparkle_db:5432/sparkle

# Redis
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=sparkle_redis:6379

# Python Backend Connection
BACKEND_URL=http://sparkle_api:8000
AGENT_ADDRESS=localhost:50051

# JWT Settings
JWT_SECRET=dev-secret-key
JWT_ISSUER=sparkle-gateway
JWT_AUDIENCE=sparkle-app

# WebSocket Settings
# Allow JWT token via query param (for Flutter IOWebSocketChannel)
ALLOW_WS_QUERY_TOKEN=true
WS_TICKET_TTL_SECONDS=3600
WS_TICKET_RATE_RPS=10

# CORS (for Flutter development)
CORS_ENABLED=true

# Internal API
INTERNAL_API_KEY=dev_internal_key

# RabbitMQ (Optional - for Galaxy Outbox Relay)
# RABBITMQ_URL=amqp://user:password@localhost:5672/

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
