# Go Gateway Environment Configuration

# Server
PORT=8080
ENVIRONMENT=development

# Database
POSTGRES_HOST=sparkle_db
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@sparkle_db:5432/sparkle

# Redis
REDIS_HOST=sparkle_redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=sparkle_redis:6379

# Python Backend Connection
BACKEND_URL=http://sparkle_api:8000
AGENT_ADDRESS=localhost:50051

# JWT Settings
JWT_SECRET=your_jwt_secret
JWT_ISSUER=sparkle-gateway
JWT_AUDIENCE=sparkle-app

# WebSocket Settings
# JWT via query param (?token=): dev-only — production forces false
ALLOW_WS_QUERY_TOKEN=true
# WSQ-2: query-carried tickets (?ticket=) have their own gate, allowed in
# production: a leak is a single-use opaque string bounded by the TTL below
ALLOW_WS_QUERY_TICKET=true
# WSQ-2: single-use ticket TTL, clamped by WS_TICKET_TTL_SECONDS_MAX
# (exceeding the ceiling is a startup Fatal; the old 3600 here was a bad example)
WS_TICKET_TTL_SECONDS=120
WS_TICKET_TTL_SECONDS_MAX=300
# WSQ-2: issuance pin 5rps/burst10 (R2: 3-device reconnect storm = 18/min
# blows through the old burst-5 budget)
WS_TICKET_RATE_RPS=5
WS_TICKET_RATE_BURST=10
# WSQ-1 pre-auth per-IP fallback pin for the 5 WS upgrade routes
# (/ws/chat, /ws/files, /ws/stt, community x2); 429 + Retry-After on excess.
WS_UPGRADE_RATE_RPS=30
WS_UPGRADE_RATE_BURST=60
# WSQ-7 tightening switch (default false, observation period): when true the
# WS auth accepts tickets ONLY — JWT header / ?token= upgrade paths are
# rejected 401 ws_ticket_required. Flip only after forced-update coverage
# (kills pre-ticket clients, design §5-R4).
WS_TICKET_REQUIRED=false

# CORS (for Flutter development)
CORS_ENABLED=true

# Internal API
INTERNAL_API_KEY=your_internal_api_key

# RabbitMQ (Optional - for Galaxy Outbox Relay)
# RABBITMQ_URL=amqp://user:password@localhost:5672/

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
