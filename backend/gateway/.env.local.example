# Gateway local development environment.

PORT=8080
ENVIRONMENT=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sparkle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/sparkle

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379

BACKEND_URL=http://127.0.0.1:8000
AGENT_ADDRESS=127.0.0.1:50051

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sparkle-files
MINIO_USE_SSL=false
MINIO_AUTO_CREATE_BUCKET=true

JWT_SECRET=dev_jwt_secret_change_me
JWT_ISSUER=sparkle-gateway
JWT_AUDIENCE=sparkle-app

ALLOW_WS_QUERY_TOKEN=true
WS_TICKET_TTL_SECONDS=3600
WS_TICKET_RATE_RPS=10
CORS_ENABLED=true
INTERNAL_API_KEY=dev_internal_key
