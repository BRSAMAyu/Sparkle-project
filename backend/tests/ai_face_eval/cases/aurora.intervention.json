          "nominated": [],
          "has_task_context": false
        }
      },
      "runtime_expectation": {
        "semantic_eligible": true,
        "feasible": ["abstain", "clarify", "connect_peer", "explain", "no_action", "pause", "reflect", "retrieve"],
        "rule_default": "no_action"
      },
      "expectations": {
        "choice": "clarify",
        "must_not_choice": ["no_action", "abstain"]
      },
      "injection": {"payload_in_input": false}
