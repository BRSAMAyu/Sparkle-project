{
  "_meta": {
    "card": "A-02 Intervention Catalog + Policy Engine V1",
    "version": "aurora_intervention_policy.v1",
    "description": "干预选择 policy engine 的场景仿真集：factors → evaluate_intervention_policy → 期望决策。基线场景（S 系列）覆盖全部结构性守卫与确定性缺省出口；A 系列为对抗场景（目录外提名/脏输入/确定性拒绝）。每条断言：selected（恒为封闭目录成员）、why（封闭 reason 码，有序精确）、exclusion_reasons（子集断言）、no_action_reason（inert 时必须为 AURORA_NO_ACTION_REASONS 成员）。",
    "guard_legend": {
      "R0.nominee_out_of_catalog": "目录外提名串（字符串自由动作）确定性拒绝",
      "R1.capability_missing": "能力需求未满足",
      "R2.permission_missing": "权限需求未满足",
      "R3.task_context_missing": "干预需要任务锚点而上下文缺失（卡面点名 practice）",
      "R4.allocation_mode_missing": "执行面干预缺 X-02 分配事实（P3-8：不静默放行，卡面点名 delegate）",
      "R5.allocation_mode_conflict": "X-02 分配 mode 与干预族冲突",
      "R6.quiet_hours_suppression": "静默时段抑制主动触达（显式请求可豁免）",
      "R7.cooldown_active": "同型干预冷却中（不作用于 inert 出口）",
      "R8.materiality_below_threshold": "materiality 门未过（显式请求可豁免）",
      "R9.proactive_budget_exhausted": "proactive 预算耗尽（显式请求可豁免）"
    }
  },
  "scenarios": [
