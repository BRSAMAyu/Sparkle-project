  "anchor": "v3/06_agent_fleet/B06_ENTITY_TRUTH_BASELINE.md §2.2-4（观察：entitlement 判级语义双实现，注释互认无跨语言等价守卫）+ §4 建议 5",
  "frozen_decision": "V3-FIX-02 / D17（users.entitlement 唯一权益真源，flame 永久禁作判据）+ D-REDEEM（users.entitlement_expires_at，NULL = 永久，宁降不升）",
  "contract": {
    "python_side": [
      "backend/app/core/entitlement.py normalize_entitlement / entitlement_grants_pro（无 expiry 面）",
      "backend/app/core/entitlement.py entitlement_effective / entitlement_effective_grants_pro（到期面）"
    ],
    "go_side": [
      "backend/gateway/internal/service/user_context.go IsProEntitlement（无 expiry 面）",
      "backend/gateway/internal/service/user_context.go IsProEntitlementEffective（到期面）"
    ],
    "equivalence": "expected_no_expiry=='pro' ⟺ normalize_entitlement(raw)=='pro' ⟺ IsProEntitlement(raw)；expected_effective=='pro' ⟺ entitlement_effective(raw, expires_at)=='pro' ⟺ IsProEntitlementEffective(raw, expiresAt)",
    "value_domain": "存储值 'free' | 'pro'；未知/缺失/空白/值域外一律降级 'free'（宁降不升，成本 fail-safe）",
    "expiry_semantics": "expires_at NULL = 永久；判级 = expiry > now 严格大于（相等即降 free，降级方向恒 pro→free）",
    "sync_rule": "两侧任一判级实现改动必须同卡同步另一侧并更新本向量文件（两侧注释互认锚点：entitlement.py 模块 docstring / user_context.go IsProEntitlementEffective 注释）",
    "consumers": {
      "python": "backend/tests/unit/test_b06_entitlement_tier_parity.py",
      "go": "backend/gateway/internal/service/entitlement_tier_parity_test.go"
    },
    "sections": {
      "cases": "双端共享向量（Go 调用面内：raw 为 string、now 取真实时钟，故到期只用远过去/远未来绝对时刻，含偏移量形式各一）",
      "python_only_cases": "Python 调用面独有能力，Go 侧不消费：raw=null/0/false（normalize 的 object|None 假值坍缩面，Go string 无 null）、expires_at==now 精确边界与 1µs 邻域（Go IsProEntitlementEffective 内取 time.Now() 无注入钟）、tz-aware/naive expiry 的 ensure_naive_utc 归一语义"
    }
  },
