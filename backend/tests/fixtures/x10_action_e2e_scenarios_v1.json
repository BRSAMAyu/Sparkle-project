        "path": "pure",
        "pure": { "risk_class": null, "reversible": null, "user_auto_grant": true }
      },
      "expected": { "authorization_mode": "confirmation" }
    },
    {
      "id": "auth_z07_pure_human_approval_flag",
      "family": "authorization",
      "category": "pure_rule",
      "summary": "纯函数：R1 审批旗标 → 不 auto",
      "inputs": {
        "path": "pure",
        "pure": {
          "risk_class": "low",
          "reversible": true,
          "requires_human_approval": true,
          "user_auto_grant": true
        }
      },
      "expected": { "authorization_mode": "confirmation", "reason_contains": "auto_forbidden_human_approval_required" }
    },
    {
      "id": "auth_z08_commit_without_confirmation_denied",
      "family": "authorization",
      "category": "commit_gate",
