        "path": "commit",
        "authorization": { "mode": "confirmation" },
        "confirmed": false
      },
      "expected": { "commit_allowed": false, "denied": true }
    },
    {
      "id": "auth_z09_commit_with_confirmation_allowed",
      "family": "authorization",
      "category": "commit_gate",
      "summary": "confirmation 模式 + approve 即确认行为 → commit 放行",
