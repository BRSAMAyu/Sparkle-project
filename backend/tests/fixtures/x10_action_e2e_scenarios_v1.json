    {
      "id": "auth_z01_service_auto_grant_executes",
      "family": "authorization",
      "category": "auto_grant",
      "summary": "用户已授低风险自动权限 + low/可逆命令 → auto 直通执行（proposal COMMITTED，任务真的改了）",
      "inputs": {
        "path": "service",
        "user_auto_grant": true,
        "execute_if_authorized": true,
        "seed_task": { "title": "X-10 auto 授权任务", "status": "PENDING", "type": "PLANNING" },
        "command": {
          "type": "task.update_fields",
          "fields": { "title": "X-10 auto 授权任务（已改名）" }
        }
      },
      "expected": {
        "authorization_mode": "auto",
        "proposal_status": "COMMITTED",
        "task_updated": true,
        "task_status": "PENDING",
        "receipt_present": true
      }
    },
    {
      "id": "auth_z02_no_grant_stays_confirmation",
      "family": "authorization",
      "category": "auto_grant",
      "summary": "未授予自动权限 → confirmation；即使携带执行意图也不执行",
      "inputs": {
        "path": "service",
        "user_auto_grant": false,
        "execute_if_authorized": true,
        "seed_task": { "title": "X-10 无授权任务", "status": "PENDING", "type": "PLANNING" },
        "command": {
          "type": "task.update_fields",
          "fields": { "title": "X-10 无授权任务（不应生效）" }
        }
      },
      "expected": {
        "authorization_mode": "confirmation",
        "proposal_status": "PENDING",
        "task_updated": false
      }
    },
    {
      "id": "auth_z03_irreversible_target_never_auto",
      "family": "authorization",
      "category": "irreversible",
      "summary": "终态命令（complete：medium/不可逆）即使有低风险授权也必须确认（high-risk auto=0 的命令面）",
      "inputs": {
        "path": "service",
        "user_auto_grant": true,
        "execute_if_authorized": true,
        "seed_task": {
          "title": "X-10 终态命令任务",
          "status": "IN_PROGRESS",
          "type": "PLANNING",
          "started_at_offset_min": -10
        },
        "command": { "type": "task.update_status", "to_status": "COMPLETED" }
      },
      "expected": {
        "authorization_mode": "confirmation",
        "proposal_status": "PENDING",
        "task_status": "IN_PROGRESS"
      }
    },
    {
      "id": "auth_z04_pure_medium_risk_not_low",
      "family": "authorization",
      "category": "pure_rule",
      "summary": "纯函数：risk=medium → 不 auto（auto_forbidden_risk_not_low）",
      "inputs": {
        "path": "pure",
        "pure": { "risk_class": "medium", "reversible": true, "user_auto_grant": true }
      },
      "expected": { "authorization_mode": "confirmation", "reason_contains": "auto_forbidden_risk_not_low" }
    },
    {
      "id": "auth_z05_pure_irreversible_low_risk",
      "family": "authorization",
      "category": "irreversible",
      "summary": "纯函数：low 但不可逆 → 不 auto",
      "inputs": {
        "path": "pure",
        "pure": { "risk_class": "low", "reversible": false, "user_auto_grant": true }
      },
      "expected": { "authorization_mode": "confirmation", "reason_contains": "auto_forbidden_irreversible" }
    },
    {
      "id": "auth_z06_pure_unclassified_unreversible_declared",
      "family": "authorization",
      "category": "pure_rule",
      "summary": "纯函数：既未分级又未声明可逆 → 不 auto（保守）",
