{
  "schema": "sparkle.x10.action-e2e.scenarios.v1",
  "description": "X-10 Action Engine E2E Evaluation scenario set (>=60). Families: allocation(X-02 rubric + vet), authorization(X-03), proposal lifecycle(X-03/X-09), run steps/resume(X-07), outcome capture(X-08), golden journeys GJ04-07. All scenarios execute against the REAL service layer with a real DB fixture; zero LLM calls. Expected targets are declarative; verdicts are independently recomputed from DB truth + pure functions by the checker.",
  "scenarios": [
    {
      "id": "alloc_a01_learning_user_core_writing",
      "family": "allocation",
      "category": "learning_guard",
      "summary": "论文写作（LEARNING/user_core/工具优势高）→ hybrid：AI 备提纲素材，用户自己创作",
      "inputs": {
        "factors": {
          "task_type": "LEARNING",
          "cognitive_ownership": "user_core",
          "tool_advantage": "high",
          "risk_class": "low",
          "reversible": true,
          "confidence": 0.9
        }
      },
      "expected": {
        "mode": "hybrid",
        "requires_human_approval": false,
        "requires_user_authored_evidence": true
      }
    },
    {
      "id": "alloc_a02_training_practice_user_core",
      "family": "allocation",
      "category": "learning_guard",
      "summary": "刷题练习（TRAINING/learning_goal/user_core）→ hybrid",
      "inputs": {
        "factors": {
          "task_type": "TRAINING",
          "learning_goal": true,
          "cognitive_ownership": "user_core",
          "tool_advantage": "medium",
          "risk_class": "low",
          "reversible": true
        }
      },
      "expected": { "mode": "hybrid", "requires_user_authored_evidence": true }
    },
    {
      "id": "alloc_a03_learning_explicit_self",
      "family": "allocation",
      "category": "explicit_intent",
      "summary": "学习任务 + 当轮显式「我自己来」→ human",
      "inputs": {
        "factors": {
          "task_type": "LEARNING",
          "cognitive_ownership": "user_core",
          "tool_advantage": "high",
          "explicit_intent": "self",
          "risk_class": "low",
          "reversible": true
        }
      },
      "expected": { "mode": "human" }
    },
    {
      "id": "alloc_a04_learning_adversarial_full_pressure",
      "family": "allocation",
      "category": "learning_guard",
      "summary": "对抗样例：学习任务 + 显式代办 + 偏好 agent + 紧急 → 守卫压过一切，hybrid（不代写）",
      "inputs": {
        "factors": {
          "task_type": "REFLECTION",
          "learning_goal": true,
          "cognitive_ownership": "user_core",
          "tool_advantage": "high",
