      "expected": { "commit_allowed": true }
    },
    {
      "id": "auth_z10_commit_auto_and_missing_record",
      "family": "authorization",
      "category": "commit_gate",
      "summary": "auto 模式放行；授权记录缺失按保守拒绝（绝不放行）",
      "inputs": {
        "path": "commit",
        "authorization": { "mode": "auto" },
        "also_missing_record": true
      },
      "expected": { "commit_allowed": true, "missing_record_denied": true }
    },
    {
      "id": "prop_p01_approve_complete_receipt_and_honest_minutes",
      "family": "proposal",
      "category": "commit_receipt",
      "summary": "提案→确认→commit→receipt；actual_minutes 从真实起止推算（绝不离 estimated）",
      "inputs": {
        "op": "approve",
        "seed_task": {
          "title": "X-10 完成任务",
          "status": "IN_PROGRESS",
          "type": "LEARNING",
          "estimated_minutes": 60,
          "started_at_offset_min": -5
        },
        "command": { "type": "task.update_status", "to_status": "COMPLETED" }
      },
      "expected": {
        "proposal_status": "COMMITTED",
        "task_status": "COMPLETED",
        "receipt_present": true,
        "actual_minutes_not_estimated": true,
        "actual_minutes_max": 8
      }
    },
    {
      "id": "prop_p02_reapprove_idempotent_replay",
      "family": "proposal",
      "category": "idempotency",
      "summary": "重复 approve 幂等：receipt 原样奉还，不重复写审计",
      "inputs": {
        "op": "approve_twice",
        "seed_task": {
          "title": "X-10 幂等确认任务",
          "status": "IN_PROGRESS",
          "type": "LEARNING",
          "started_at_offset_min": -5
        },
        "command": { "type": "task.update_status", "to_status": "COMPLETED" }
      },
      "expected": {
        "proposal_status": "COMMITTED",
        "second_applied": false,
        "second_already_committed": true,
        "transitions_count": 2
      }
    },
    {
      "id": "prop_p03_recreate_same_key_single_proposal",
