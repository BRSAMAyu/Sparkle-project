# ============================================================
# State Change Notification Tests
# ============================================================

class TestStateChangeNotifications:
    """Test state change notifications via WebSocket"""

    @pytest.mark.asyncio
    async def test_plan_archived_notification(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User,
        test_plan: Plan,
        db: AsyncSession
    ):
        """Test notification when plan is archived"""
        uri = f"{websocket_url}?token={auth_token}"

        async with websockets.connect(uri) as websocket:
            # Archive the plan (simulate API call)
            test_plan.status = "archived"
            await db.commit()

            # Trigger notification
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_plan_archived(
                user_id=str(test_user.id),
                plan_name=test_plan.name,
                plan_id=str(test_plan.id),
                task_count_freed=10,
                memory_count_removed=5,
                new_primary_plan=None
            )

            # Listen for notification
            notification_received = False
            notification_data = None

            try:
                response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                data = json.loads(response)

                # Check for state change event
                metadata = data.get("metadata", {})
                if "state_change_event" in metadata:
                    notification_received = True
                    notification_data = metadata["state_change_event"]

                    assert notification_data["change_type"] == "plan_archived"
                    assert test_plan.name in metadata.get("formatted_message", "")

            except asyncio.TimeoutError:
                pass

            # Restore for cleanup
            test_plan.status = "active"
            await db.commit()

    @pytest.mark.asyncio
    async def test_plan_restored_notification(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User,
        test_plan: Plan,
        db: AsyncSession
    ):
        """Test notification when plan is restored"""
        uri = f"{websocket_url}?token={auth_token}"

        # First archive the plan
        test_plan.status = "archived"
        await db.commit()

        async with websockets.connect(uri) as websocket:
            # Restore the plan
            test_plan.status = "active"
            await db.commit()

            # Trigger notification
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_plan_restored(
                user_id=str(test_user.id),
                plan_name=test_plan.name,
                plan_id=str(test_plan.id)
            )

            # Listen for notification
            try:
                response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                data = json.loads(response)

                metadata = data.get("metadata", {})
                if "state_change_event" in metadata:
                    event_data = metadata["state_change_event"]
                    assert event_data["change_type"] == "plan_restored"
                    assert test_plan.name in metadata.get("formatted_message", "")

            except asyncio.TimeoutError:
                pass

    @pytest.mark.asyncio
    async def test_plan_deleted_notification(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User,
        test_plan: Plan,
        db: AsyncSession
    ):
        """Test notification when plan is deleted"""
        uri = f"{websocket_url}?token={auth_token}"

        plan_name = test_plan.name
        plan_id = str(test_plan.id)

        async with websockets.connect(uri) as websocket:
            # Delete the plan
            await db.delete(test_plan)
            await db.commit()

            # Trigger notification
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_plan_deleted(
                user_id=str(test_user.id),
                plan_name=plan_name,
                plan_id=plan_id,
                task_count_freed=10,
                memory_count_removed=5
            )

            # Listen for notification
            try:
                response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                data = json.loads(response)

                metadata = data.get("metadata", {})
                if "state_change_event" in metadata:
                    event_data = metadata["state_change_event"]
                    assert event_data["change_type"] == "plan_deleted"
                    assert "释放" in metadata.get("formatted_message", "")

            except asyncio.TimeoutError:
                pass

            # Recreate plan for other tests
            new_plan = Plan(
                user_id=test_user.id,
                name=plan_name,
                description="Recreated for tests",
                status="active"
            )
            db.add(new_plan)
            await db.commit()


# ============================================================
# Settings Update Notification Tests
# ============================================================

class TestSettingsUpdateNotifications:
    """Test settings update notifications"""

    @pytest.mark.asyncio
    async def test_transparency_level_change(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User,
        db: AsyncSession
    ):
        """Test notification when transparency level changes"""
        uri = f"{websocket_url}?token={auth_token}"

        async with websockets.connect(uri) as websocket:
            # Simulate settings change
            old_value = 0
            new_value = 2

            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_user_settings_updated(
                user_id=str(test_user.id),
                field_name="transparency_level",
                old_value=str(old_value),
                new_value=str(new_value),
                impact_description="这将影响你未来的学习体验，系统将提供更多透明度信息"
            )

            # Listen for notification
            try:
                response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                data = json.loads(response)

                metadata = data.get("metadata", {})
                if "state_change_event" in metadata:
                    event_data = metadata["state_change_event"]
                    assert event_data["change_type"] == "settings_updated"
                    assert event_data["field_name"] == "transparency_level"

            except asyncio.TimeoutError:
                pass

    @pytest.mark.asyncio
    async def test_multiple_settings_changes(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User
    ):
        """Test multiple settings change notifications"""
        uri = f"{websocket_url}?token={auth_token}"

        async with websockets.connect(uri) as websocket:
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            # Send multiple notifications
            settings_changes = [
                ("transparency_level", "0", "2", "影响透明度信息显示"),
                ("system_update_level", "minimal", "standard", "影响系统更新通知"),
            ]

            for field, old_val, new_val, impact in settings_changes:
                await notification_service.notify_user_settings_updated(
                    user_id=str(test_user.id),
                    field_name=field,
                    old_value=old_val,
                    new_value=new_val,
                    impact_description=impact
                )

            # Collect notifications
            notifications = []
            for _ in range(len(settings_changes)):
                try:
                    response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                    data = json.loads(response)
                    notifications.append(data)
                except asyncio.TimeoutError:
                    break

            # Should receive multiple notifications
            assert len(notifications) >= 1


