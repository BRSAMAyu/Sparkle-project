class TestNotificationCenterAPI:
    """Test notification center API endpoints"""

    @pytest.mark.asyncio
    async def test_create_notification(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test creating a notification"""
        notification = Notification(
            user_id=test_user.id,
            type="system",
            title="Test Notification",
            content="This is a test notification",
            priority="medium",
            metadata={"test_key": "test_value"}
        )
        db.add(notification)
        await db.commit()
        await db.refresh(notification)

        assert notification.id is not None
        assert notification.is_read == False

        # Cleanup
        await db.delete(notification)
        await db.commit()

    @pytest.mark.asyncio
    async def test_mark_notification_read(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test marking notification as read"""
        notification = Notification(
            user_id=test_user.id,
            type="system",
            title="Test Notification",
            content="This is a test notification",
            priority="medium"
        )
        db.add(notification)
        await db.commit()

        # Mark as read
        notification.is_read = True
        notification.read_at = datetime.now(UTC).replace(tzinfo=None)
        await db.commit()

        # Verify
        await db.refresh(notification)
        assert notification.is_read == True
        assert notification.read_at is not None

        # Cleanup
        await db.delete(notification)
        await db.commit()

    @pytest.mark.asyncio
    async def test_notification_interaction(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test recording notification interaction"""
        notification = Notification(
            user_id=test_user.id,
            type="system",
            title="Test Notification",
            content="This is a test notification",
            priority="medium"
        )
        db.add(notification)
        await db.commit()
        await db.refresh(notification)

        # Create interaction record
        interaction = NotificationInteraction(
            user_id=test_user.id,
            notification_type="system",
            notification_id=str(notification.id),
            action_type="clicked"
        )
        db.add(interaction)
        await db.commit()

        assert interaction.id is not None
        assert interaction.action_type == "clicked"

        # Cleanup
        await db.delete(interaction)
        await db.delete(notification)
        await db.commit()


