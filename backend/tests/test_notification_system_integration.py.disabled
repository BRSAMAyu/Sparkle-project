class TestNotificationPreferences:
    """Test notification preferences"""

    @pytest.mark.asyncio
    async def test_get_user_preferences(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test getting user notification preferences"""
        result = await db.execute(
            select(NotificationPreferences).where(
                NotificationPreferences.user_id == test_user.id
            )
        )
        prefs = result.scalar_one_or_none()

        assert prefs is not None
        assert prefs.user_id == test_user.id
        assert prefs.notification_level in ["minimal", "standard", "verbose"]

    @pytest.mark.asyncio
    async def test_update_notification_level(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test updating notification level"""
        result = await db.execute(
            select(NotificationPreferences).where(
                NotificationPreferences.user_id == test_user.id
            )
        )
        prefs = result.scalar_one_or_none()

        if not prefs:
            prefs = NotificationPreferences(
                user_id=test_user.id,
                notification_level="standard"
            )
            db.add(prefs)
            await db.commit()

        # Update level
        prefs.notification_level = "verbose"
        await db.commit()

        # Verify
        await db.refresh(prefs)
        assert prefs.notification_level == "verbose"

    @pytest.mark.asyncio
    async def test_disable_system_notifications(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test disabling system notifications"""
        result = await db.execute(
            select(NotificationPreferences).where(
                NotificationPreferences.user_id == test_user.id
            )
        )
        prefs = result.scalar_one_or_none()

        if not prefs:
            prefs = NotificationPreferences(
                user_id=test_user.id,
                notification_level="standard"
            )
            db.add(prefs)
            await db.commit()

        # Disable system notifications
        prefs.system_notifications_enabled = False
        await db.commit()

        # Verify
        await db.refresh(prefs)
        assert prefs.system_notifications_enabled == False


# ============================================================
# Notification Analytics Tests
# ============================================================

class TestNotificationAnalytics:
    """Test notification analytics"""

    @pytest.mark.asyncio
    async def test_notification_summary(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test getting notification summary statistics"""
        # Create test notifications
        notifications = [
            Notification(
                user_id=test_user.id,
                type="system",
                title=f"Test Notification {i}",
                content=f"Test content {i}",
                priority="medium" if i % 2 == 0 else "high",
                is_read=(i % 3 == 0)  # Every 3rd is read
            )
            for i in range(10)
        ]

        for n in notifications:
            db.add(n)
        await db.commit()

        # Calculate summary
        result = await db.execute(
            select(Notification).where(Notification.user_id == test_user.id)
        )
        all_notifications = result.scalars().all()

        total_sent = len(all_notifications)
        total_read = sum(1 for n in all_notifications if n.is_read)

        assert total_sent == 10
        assert total_read >= 0

        # Cleanup
        for n in all_notifications:
            await db.delete(n)
        await db.commit()

    @pytest.mark.asyncio
    async def test_notification_by_type(
        self,
        db: AsyncSession,
        test_user: User
    ):
        """Test grouping notifications by type"""
        # Create different types
        notifications = [
            Notification(
                user_id=test_user.id,
                type="system",
                title="System Notification",
                content="Test",
                priority="low"
            ),
            Notification(
                user_id=test_user.id,
                type="intervention",
                title="Intervention Request",
                content="Test",
                priority="high"
            )
        ]

        for n in notifications:
            db.add(n)
        await db.commit()

        # Query by type
        result = await db.execute(
            select(Notification).where(
                Notification.user_id == test_user.id,
                Notification.type == "system"
            )
        )
        system_notifications = result.scalars().all()

        assert len(system_notifications) == 1
        assert system_notifications[0].type == "system"

        # Cleanup
        for n in notifications:
            await db.delete(n)
        await db.commit()


# ============================================================
# Integration Test: Full Notification Flow
# ============================================================

class TestFullNotificationFlow:
    """Test complete notification flow from creation to display"""

    @pytest.mark.asyncio
    async def test_notification_delivery_to_client(
        self,
        websocket_url: str,
        auth_token: str,
        test_user: User
    ):
        """Test notification creation → WebSocket delivery → Client receive"""
        uri = f"{websocket_url}?token={auth_token}"

        async with websockets.connect(uri) as websocket:
            # Create notification in backend
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_user_settings_updated(
                user_id=str(test_user.id),
                field_name="test_field",
                old_value="old",
                new_value="new",
                impact_description="Test impact"
            )

            # Listen for notification
            received = False
            try:
                response = await asyncio.wait_for(websocket.recv(), timeout=5.0)
                data = json.loads(response)

                metadata = data.get("metadata", {})
                received = "state_change_event" in metadata

            except asyncio.TimeoutError:
                pass

            assert received, "Should receive notification via WebSocket"

    @pytest.mark.asyncio
    async def test_multiple_users_notifications(
        self,
        websocket_url: str,
        db: AsyncSession,
        test_user: User
    ):
        """Test that notifications only go to intended users"""
        # Create another user
        other_user = User(
            email="other_user@example.com",
            nickname="Other User",
            password_hash="test"
        )
        db.add(other_user)
        await db.commit()
        await db.refresh(other_user)

        # Get tokens for both users
        token1 = create_access_token(data={"sub": str(test_user.id)})
        token2 = create_access_token(data={"sub": str(other_user.id)})

        # Connect both users
        uri1 = f"{websocket_url}?token={token1}"
        uri2 = f"{websocket_url}?token={token2}"

        async with websockets.connect(uri1) as ws1, \
                   websockets.connect(uri2) as ws2:

            # Send notification only to user1
            from app.services.state_notification_service import get_ws_manager
            ws_manager = get_ws_manager()
            notification_service = StateNotificationService(ws_manager)

            await notification_service.notify_user_settings_updated(
                user_id=str(test_user.id),  # Only user1
                field_name="test_field",
                old_value="old",
                new_value="new",
                impact_description="Test"
            )

            # User1 should receive
            try:
                response1 = await asyncio.wait_for(ws1.recv(), timeout=5.0)
                user1_received = True
            except asyncio.TimeoutError:
                user1_received = False

            # User2 should NOT receive
            try:
                response2 = await asyncio.wait_for(ws2.recv(), timeout=1.0)
                user2_received = True
            except asyncio.TimeoutError:
                user2_received = False

            assert user1_received, "User1 should receive notification"
            assert not user2_received, "User2 should NOT receive notification"

        # Cleanup
        await db.delete(other_user)
        await db.commit()


