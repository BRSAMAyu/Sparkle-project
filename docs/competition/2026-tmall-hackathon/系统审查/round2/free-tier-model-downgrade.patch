+        if ceiling is None:
+            return tiers, None
+        ceiling_tier, ceiling_rank = ceiling
+
+        def _rank(tier: ModelTier) -> int | None:
+            return _CAPABILITY_TIER_RANK.get(self._normalize_tier_value(tier))
+
