+    )
+    op.add_column(
+        "user_settings",
+        sa.Column(
+            "accessibility_settings",
+            postgresql.JSONB(astext_type=sa.Text()),
+            nullable=False,
+            server_default=sa.text("'{}'::jsonb"),
+        ),
+    )
