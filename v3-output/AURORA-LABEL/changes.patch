+    logger.info("Auto-provisioned UUID-backed experiment {} for gateway slug {}", experiment.id, slug)
+    AB_EXPERIMENT_SLUG_RESOLUTION_TOTAL.labels(slug=slug, outcome="provisioned").inc()
+    return experiment
