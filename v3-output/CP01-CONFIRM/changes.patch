+def test_migration_is_reentrant(migration_env):
+    engine, run_migration, load_upgrade_downgrade = migration_env
+    upgrade, downgrade = load_upgrade_downgrade()
+
+    run_migration(upgrade)
+    run_migration(downgrade)
