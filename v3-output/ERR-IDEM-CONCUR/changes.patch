+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+        await conn.execute(text(MASTERY_AUDIT_LOG_DDL))
+        await conn.execute(text(IDEM_UNIQUE_INDEX_DDL))
