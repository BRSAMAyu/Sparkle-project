+// restTimeString formats a proto Timestamp as the RFC3339 UTC string the REST
+// face's ISO-8601 datetimes normalize to; nil → nil (JSON null).
+func restTimeString(ts *timestamppb.Timestamp) any {
+	if ts == nil {
+		return nil
 	}
