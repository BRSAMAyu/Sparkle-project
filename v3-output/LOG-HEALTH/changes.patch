diff --git a/redis.conf b/redis.conf
index 9d35037b..5d7035a4 100755
--- a/redis.conf
+++ b/redis.conf
@@ -3,11 +3,22 @@ bind 0.0.0.0
 protected-mode yes
 port 6379
 
+# NOTE: the redis-stack-server wrapper launches redis-server with
+# `--protected-mode no` on the command line, which overrides the value above.
+# Auth is enforced by the ACL file below instead (all users have passwords).
+
 # Production RBAC is enabled by docker-compose.prod.yml with a generated ACL
 # file passed via --aclfile. Local development keeps the single-password path.
 aclfile /tmp/users.acl
 
+# NOTE: do NOT add a `dir` directive here. The wrapper always passes its own
+# `--dir /var/lib/redis-stack` on the command line, which would override it.
+# The data directory is pinned to /data by docker-compose.prod.yml appending
+# `--dir /data` after the conf path (last CLI value wins).
+
 # Memory Management
+# 3gb vs the prod container limit (4G in x-resources): ~1G headroom for
+# fork copy-on-write during AOF rewrite. Re-size together with the limit.
 maxmemory 3gb
 maxmemory-policy volatile-lru
 
