+        user default on >$${REDIS_PASSWORD} ~* +@all
+        user gateway on >$${REDIS_GATEWAY_PASSWORD} ~gateway:* ~chat:* ~session:* ~auth:* ~ws:* ~file:* ~cqrs:* ~rate:* ~ratelimit:* ~health:* +@read +@write +@connection +@pubsub -@admin -@dangerous
