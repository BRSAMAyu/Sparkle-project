+                user_id=user_id,
+                memory_type="memory_epoch",
+                memory_id=settings_row.id,
+                action="epoch_bump",
+                reason=trimmed_reason,
+            )
+        )
+        await self.db.commit()
+        return int(settings_row.memory_epoch)
