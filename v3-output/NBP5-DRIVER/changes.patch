+
+def test_judge_episodic_capture_four_paths() -> None:
+    """首读达标 pass；升级读达标 pass+延迟注记；未做升级读 blocked；双读皆空 fail。"""
+    assert judge_episodic_capture(3, None, 3)[0] == "pass"
+    verdict, note = judge_episodic_capture(0, 3, 3)
