+            ),
+            {"pid": plan_id, "gj": guide_json_text, "tid": task_id},
+        )
+    else:
+        bind.execute(
+            sa.text("UPDATE tasks SET plan_id = :pid, guide_json = :gj WHERE id = :tid AND plan_id IS NULL"),
+            {"pid": plan_id, "gj": guide_json_text, "tid": task_id},
+        )
+
