+				if ctx.Err() != nil {
+					// PROD-LOG #8: graceful shutdown 会打断阻塞中的 XReadGroup，
+					// 以 "context canceled" 出错——属预期退出方式，降 INFO 且不再
+					// 退避重试；仅进程上下文仍存活时的失败保持 ERROR。
+					w.logger.Info("Worker stopping", zap.Error(err))
