 def test_truth_path_modules_never_read_client_telemetry(rel_path):
     source_path = BACKEND_DIR / rel_path
     assert source_path.exists(), f"truth-path module moved: {rel_path}"
-    source = source_path.read_text(encoding="utf-8")
