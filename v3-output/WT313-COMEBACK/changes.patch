+        status=TaskStatus.COMPLETED if completed else TaskStatus.PENDING,
+        priority=2,
+        order_index=day * 1000,
+    )
+    if completed:
+        task.updated_at = _utcnow_naive() - timedelta(days=completed_days_ago)
+    db_session.add(task)
+
