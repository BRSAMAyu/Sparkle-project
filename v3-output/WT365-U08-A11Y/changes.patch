+-LOW_STIMULATION_NUDGE_SUPPRESS_HOURS = 72
+-
+-
+-@dataclass(slots=True, frozen=True)
+-class StimulationPolicy:
+-    """Behavioral budget derived from the explicit setting (never a diagnosis)."""
+-
+-    level: str = STIMULATION_STANDARD
