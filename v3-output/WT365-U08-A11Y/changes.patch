+-+# 口径对照（小写串形状保留为回归证明，种子与卡面一致）
+-+# ---------------------------------------------------------------------------
+-+
+-+@pytest.mark.asyncio
+-+async def test_lowercase_literal_versus_fixed_caliber_on_card_seed(db):
+-+    """同一混合种子：旧小写形状 (0,3)→0.0；修复口径 (1,2)→0.5。"""
+-+    session, _maker = db
+-+    user, plan, _goal, _tasks = await _seed_mixed_batch(session)
