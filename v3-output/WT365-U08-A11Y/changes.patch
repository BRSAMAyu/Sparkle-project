+-        return {
+-            "level": self.level,
+-            "allow_proactive_push": self.allow_proactive_push,
+-            "proactive_suppress_hours": self.proactive_suppress_hours,
+-            "quiet_title": self.quiet_title,
+-        }
+-
+-
+-#: auto 档当前无引擎侧信号源——保守落 standard，行为与历史完全一致。
