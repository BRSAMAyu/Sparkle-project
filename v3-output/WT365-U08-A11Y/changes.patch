+-+            Task.user_id == user.id,
+-+            Task.deleted_at.is_(None),
+-+        )
+-+    )
+-+    assert (lowercase_completed, unfiltered_total) == (0, 3)
+-+    assert (fixed_completed, fixed_total) == (1, 2)
+-+    assert fixed_completed / fixed_total == pytest.approx(0.5)
